    >
        // On rend les données accessibles globalement pour notre script externe
        window.biomeData = biomeData;
        window.biomeName = biomeName;
        window.allBiomes = allBiomes;
    </script>
    <script>
        // Logique du lancer de dé
        document.addEventListener('DOMContentLoaded', () => {
            const diceContainer = document.getElementById('dice-container');
            const diceSvg = document.getElementById('Calque_2');
            const diceResult = document.getElementById('dice-result');
            let isRolling = false;

            if (diceContainer && diceSvg && diceResult) {
                diceContainer.addEventListener('click', () => {
                    if (isRolling) return;
                    isRolling = true;
                    
                    // Cacher le chiffre actuel
                    diceResult.style.opacity = '0';
                    
                    // Animation de rotation
                    const anim = diceSvg.animate([
                        { transform: 'rotate(0deg)' },
                        { transform: 'rotate(720deg)' }
                    ], {
                        duration: 800,
                        easing: 'cubic-bezier(0.25, 0.46, 0.45, 0.94)' // easeOutQuad
                    });

                    anim.onfinish = () => {
                        // Générer un nouveau chiffre entre 1 et 20
                        const roll = Math.floor(Math.random() * 20) + 1;
                        diceResult.textContent = roll;
                        
                        // Réafficher le chiffre
                        diceResult.style.opacity = '1';
                        isRolling = false;
                    };
                });
            }

            // Écouteur pour le bouton de test DEV (utilise window.changeBiome de game.js)
            const devBtn = document.getElementById('dev-biome-btn');
            const devSelect = document.getElementById('dev-biome-select');
            
            if (devBtn && devSelect) {
                devBtn.addEventListener('click', () => {
                    if(typeof window.changeBiome === 'function') {
                        window.changeBiome(devSelect.value);
                    } else {
                        console.error('La fonction changeBiome est introuvable.');
                    }
                });
            }
        });
    </script>
    <script src="../../../src/scripts/game.js"></script>
</Layout>