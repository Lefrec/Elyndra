---
import Layout from "../../layout/Layout.astro";
import "/src/styles/global.css";
import lunel from "../../assets/biomes/lunel.webp";
import solarys from "../../assets/biomes/solarys.webp";
import auralis from "../../assets/biomes/auralis.webp";
import elyndra from "../../assets/biomes/elyndra.webp";

// Récupérer le paramètre de biome depuis l'URL
const { biome } = Astro.params;

// Configuration des biomes
const biomesConfig = {
    lunel: {
        name: "Lunel",
        fullName: "Le Cœur Sylvestre de Lunel",
        description: "Une jungle oppressante avec des cités perchées",
        image: lunel,
        colors: {
            primary: "text-green-200/95",
            bgGradient:
                "bg-[radial-gradient(ellipse_50.00%_50.00%_at_50.00%_50.00%,_#1F3F0D_0%,_#010700_100%)]",
            chatBg: "bg-[radial-gradient(ellipse_50.00%_50.00%_at_50.00%_50.00%,_#002307_0%,_#001D07_50%,_#001005_100%)]",
            messageBg: "bg-green-950",
            messageText: "text-green-300",
            locationText: "text-green-300",
            buttonBg: "bg-green-800",
            buttonHover: "hover:bg-green-700",
            svgPrimary: "#5AB061",
            svgSecondary: "#113003",
            svgGradientLight: "#7CF885",
            svgGradientDark: "#509555",
            svgStroke: "#234324",
        },
        startPrompt:
            "Je commence mon aventure dans la forêt du cœur sylvestre de Lunel",
    },
    solarys: {
        name: "Solarys",
        fullName: "Les Dunes ardentes de Solarys",
        description: "Une immensité aride avec un oasis solitaire",
        image: solarys,
        colors: {
            primary: "text-orange-200/95",
            bgGradient:
                "bg-[radial-gradient(ellipse_50.00%_50.00%_at_50.00%_50.00%,_#3F2D0D_0%,_#0A0700_100%)]",
            chatBg: "bg-[radial-gradient(ellipse_50.00%_50.00%_at_50.00%_50.00%,_#231007_0%,_#1D0C07_50%,_#100500_100%)]",
            messageBg: "bg-orange-950",
            messageText: "text-orange-300",
            locationText: "text-orange-300",
            buttonBg: "bg-orange-800",
            buttonHover: "hover:bg-orange-700",
            svgPrimary: "#FF8C42",
            svgSecondary: "#8B4513",
            svgGradientLight: "#FFB088",
            svgGradientDark: "#D97742",
            svgStroke: "#4A2511",
        },
        startPrompt:
            "Je commence mon aventure dans les dunes ardentes de Solarys",
    },
    auralis: {
        name: "Auralis",
        fullName: "Le Village Gelé d'Auralis",
        description: "Un refuge givré avec des vents mordants",
        image: auralis,
        colors: {
            primary: "text-blue-200/95",
            bgGradient:
                "bg-[radial-gradient(ellipse_50.00%_50.00%_at_50.00%_50.00%,_#0D1F3F_0%,_#000107_100%)]",
            chatBg: "bg-[radial-gradient(ellipse_50.00%_50.00%_at_50.00%_50.00%,_#071023_0%,_#070D1D_50%,_#050010_100%)]",
            messageBg: "bg-blue-950",
            messageText: "text-blue-300",
            locationText: "text-blue-300",
            buttonBg: "bg-blue-800",
            buttonHover: "hover:bg-blue-700",
            svgPrimary: "#5AB0FF",
            svgSecondary: "#001133",
            svgGradientLight: "#7CC8FF",
            svgGradientDark: "#5095D9",
            svgStroke: "#243447",
        },
        startPrompt: "Je commence mon aventure dans le village gelé d'Auralis",
    },
    elyndra: {
        name: "Élyndra",
        fullName: "Les Ruines Oubliées d'Élyndra",
        description: "Une cité perdue avec des pierres runiques",
        image: elyndra,
        colors: {
            primary: "text-purple-200/95",
            bgGradient:
                "bg-[radial-gradient(ellipse_50.00%_50.00%_at_50.00%_50.00%,_#2D0D3F_0%,_#07000A_100%)]",
            chatBg: "bg-[radial-gradient(ellipse_50.00%_50.00%_at_50.00%_50.00%,_#100723_0%,_#0D071D_50%,_#050010_100%)]",
            messageBg: "bg-purple-950",
            messageText: "text-purple-300",
            locationText: "text-purple-300",
            buttonBg: "bg-purple-800",
            buttonHover: "hover:bg-purple-700",
            svgPrimary: "#9D5AFF",
            svgSecondary: "#330044",
            svgGradientLight: "#C88FFF",
            svgGradientDark: "#8550D9",
            svgStroke: "#472447",
        },
        startPrompt:
            "Je commence mon aventure au milieu des Ruines oubliées d'Élyndra",
    },
};

// Vérifie si le biome existe, sinon rediriger ou utiliser un biome par défaut
const currentBiome =
    biomesConfig[biome as keyof typeof biomesConfig] || biomesConfig.lunel;

// Récupère l'inventaire depuis PocketBase
let inventoryRecords = [];
try {
    inventoryRecords = await Astro.locals.pb.collection("Inventory").getFullList({
        sort: '-created',
    });
} catch (error) {
    console.error("Erreur lors de la récupération de l'inventaire:", error);
}

// Extraire les données pour le client (sans les imports d'images qui posent problème)
const biomesDataForClient = Object.fromEntries(
    Object.entries(biomesConfig).map(([key, data]) => [
        key,
        {
            name: data.name,
            fullName: data.fullName,
            description: data.description,
            colors: data.colors,
            startPrompt: data.startPrompt,
        },
    ]),
);
---

<Layout hideHeaderFooter={true}>
    <div class="min-h-screen bg-neutral-950">
        <!-- En-tête du biome -->
        <header
            class="w-full mx-auto min-h-[80px] py-4 px-4 md:px-12 lg:px-24 grid grid-cols-[1fr_auto_1fr] items-center gap-2 sm:gap-4"
        >
            <div class="flex justify-start min-w-0">
                <button
                    id="verbomnes-button"
                    class={`px-3 sm:px-4 py-2 sm:py-3.5 ${currentBiome.colors.buttonBg} ${currentBiome.colors.buttonHover} transition-colors rounded-[10px] flex justify-center items-center shrink-0 z-10`}
                >
                    <span class="text-white text-[11px] sm:text-base whitespace-nowrap">Vos Verbomnes</span>
                </button>
            </div>

            <div class="flex flex-col justify-center items-center min-w-0">
                <h1
                    id="biome-title"
                    class={`text-center ${currentBiome.colors.primary} text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-bold font-['Cinzel_Decorative'] truncate max-w-full px-2`}
                >
                    {currentBiome.name}
                </h1>
            </div>

            <!-- Menu hamburger avec SVG -->
            <div class="flex justify-end min-w-0">
                <button
                    id="menu-toggle"
                    class="px-3 sm:px-4 py-2 sm:py-4 bg-zinc-950 hover:bg-zinc-900 transition-colors rounded flex justify-center items-center z-50 relative group shrink-0"
                >
                    <img
                        src="/menu-hamburger.svg"
                        alt="Menu"
                        class="w-6 h-5 sm:w-8 sm:h-6 transition-transform duration-300 group-hover:scale-110"
                        id="burger-icon"
                    />
                </button>
            </div>
        </header>

        <!-- Modal Verbomnes -->
        <div
            id="verbomnes-modal"
            class="fixed inset-0 bg-black/70 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300 z-50"
        >
            <div
                class="relative bg-black border-2 border-Or-clair rounded-lg shadow-2xl max-w-4xl w-full mx-4 p-10 transform scale-95 transition-transform duration-300"
            >
                <!-- Bouton fermer -->
                <button
                    id="close-verbomnes"
                    class="absolute top-6 right-6 w-8 h-8 border-2 border-Or-clair hover:bg-Or-clair/20 transition-colors flex items-center justify-center"
                >
                    <span class="text-Or-clair text-xl">×</span>
                </button>

                <!-- Titre -->
                <div class="mb-6">
                    <h2
                        class="text-Or-clair text-4xl font-['Cinzel_Decorative'] uppercase text-center tracking-[3px] mb-4"
                    >
                        L'Oracle des Verbomnes
                    </h2>
                    <div class="flex justify-center items-center gap-3">
                        <div
                            class="w-24 h-px bg-gradient-to-r from-transparent via-orange-200 to-transparent"
                        >
                        </div>
                        <div class="w-1 h-1 bg-orange-200 rounded-full"></div>
                        <div
                            class="w-24 h-px bg-gradient-to-r from-transparent via-orange-200 to-transparent"
                        >
                        </div>
                    </div>
                </div>

                <!-- Description -->
                <p
                    class="text-center text-white text-base font-['Almendra'] tracking-wide mb-8"
                >
                    Chaque parole façonne le destin. Mais même les dieux ont
                    leurs limites.
                </p>

                <!-- Contenu principal -->
                <div
                    class="flex flex-col md:flex-row gap-12 items-center justify-center mb-8"
                >
                    <!-- Compteur de Verbomnes -->
                    <div class="relative flex items-center justify-center py-8 md:py-0">
                        <!-- Cercle décoratif -->
                        <div
                            class="absolute w-56 h-56 sm:w-72 sm:h-72 border border-Or-clair opacity-30 rounded-full shadow-[0px_4px_15px_0px_rgba(255,233,181,0.5)]"
                        >
                        </div>
                        <div
                            class="absolute w-44 h-44 sm:w-60 sm:h-56 border border-Or-clair opacity-20"
                        >
                        </div>

                        <!-- Nombre et texte -->
                        <div class="relative text-center z-10">
                            <div
                                class="text-Or-clair text-5xl sm:text-6xl font-['Cinzel_Decorative'] leading-none sm:leading-[96px] mb-2"
                            >
                                128
                            </div>
                            <div
                                class="text-orange-200 text-sm sm:text-base tracking-widest"
                            >
                                Verbomnes restants
                            </div>
                        </div>
                    </div>

                    <!-- Explications -->
                    <div class="max-w-md space-y-6">
                        <div>
                            <h3
                                class="text-Or-clair text-lg tracking-wide mb-3"
                            >
                                L'Oracle murmure encore
                            </h3>
                            <p class="text-white text-sm leading-5">
                                Chaque action formulée par le joueur invoque
                                l'Oracle. Lorsque toutes les Verbomnes ont été
                                consommées, le récit ne peut plus se poursuivre.
                            </p>
                        </div>
                        <div>
                            <p class="text-white text-sm leading-5">
                                L'Oracle d'Elyndra est animé par une
                                intelligence artificielle de génération de
                                langage, agissant comme narrateur dynamique dans
                                un univers et des règles définis par les
                                créateurs.
                            </p>
                        </div>

                        <!-- Bouton membre -->
                        <a
                            href="/"
                            class="w-full px-4 py-3 bg-elyndra-3 hover:bg-yellow-600 transition-colors rounded-[10px] text-center"
                        >
                            <span class="text-white text-xs"
                                >Découvrez nos offres pour plus de Verbomnes !</span
                            >
                        </a>
                    </div>
                </div>

                <!-- Footer -->
                <div class="text-center mb-4">
                    <p class="text-Or-clair text-sm tracking-wide">
                        Technologie fournie par Perplexity
                    </p>
                </div>

                <!-- Séparateur final -->
                <div class="flex justify-center items-center gap-3.5">
                    <div
                        class="w-24 h-px bg-gradient-to-r from-transparent via-orange-200 to-transparent"
                    >
                    </div>
                    <div class="w-1 h-1 bg-orange-200 rounded-full"></div>
                    <div
                        class="w-24 h-px bg-gradient-to-r from-transparent via-orange-200 to-transparent"
                    >
                    </div>
                </div>
            </div>
        </div>

        <!-- Menu latéral -->
        <nav
            id="side-menu"
            class="fixed top-0 right-0 h-full w-80 bg-neutral-950 border-l border-Or-clair shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out z-40 overflow-y-auto"
        >
            <div class="p-6">
                <!-- Bouton fermer en haut à droite -->
                <button
                    id="close-menu"
                    class="absolute top-4 right-4 w-10 h-10 flex items-center justify-center bg-zinc-900 hover:bg-zinc-800 rounded transition-colors group"
                >
                    <span
                        class="text-Or-clair text-3xl leading-none group-hover:scale-110 transition-transform"
                        >×</span
                    >
                </button>

                <!-- En-tête du menu -->
                <div class="mb-8 pb-4 border-b border-Or-clair/30">
                    <h2 class="text-Or-clair text-2xl">Menu</h2>
                </div>

                <!-- Navigation -->
                <ul class="space-y-4">
                    <li>
                        <a
                            href="/#"
                            class="block px-4 py-3 text-white hover:text-Or-clair hover:bg-[#292929FF]/50 rounded transition-colors"
                        >
                            Accueil
                        </a>
                    </li>
                    <li>
                        <button
                            id="save-btn"
                            class="w-full text-left px-4 py-3 hover:text-Or-clair hover:bg-[#292929FF]/50 rounded transition-colors"
                        >
                            Sauvegarder
                        </button>
                    </li>
                    <li>
                        <button
                            class="w-full text-left px-4 py-3 text-white hover:text-Or-clair hover:bg-[#292929FF]/50 rounded transition-colors"
                        >
                            Paramètres
                        </button>
                    </li>
                    <li>
                        <a
                            href="/contact"
                            class="block px-4 py-3 text-white hover:text-Or-clair hover:bg-[#292929FF]/50 rounded transition-colors"
                        >
                            Aide
                        </a>
                    </li>
                </ul>

                <!-- Retour -->
                <div class="mt-8 pt-6 border-t border-Or-clair/30">
                    <a
                        href="/"
                        class="block w-full text-center px-4 py-3 bg-red-900 hover:bg-red-800 text-white rounded transition-colors"
                    >
                        ← Quitter l'aventure
                    </a>
                </div>
            </div>
        </nav>

        <!-- Overlay pour fermer le menu -->
        <div
            id="menu-overlay"
            class="fixed inset-0 bg-black/50 opacity-0 pointer-events-none transition-opacity duration-300 z-30"
        >
        </div>

        <!-- Interface principale -->
        <main class="px-2.5 pb-4">
            <div
                id="main-container"
                class={`max-w-[1400px] mx-auto ${currentBiome.colors.bgGradient} rounded-md border border-Or-clair p-2.5`}
            >
                <div class="flex flex-col lg:flex-row gap-4 lg:gap-2.5 min-h-[calc(100vh-150px)] lg:min-h-[705px]">
                    <!-- Panneau gauche - Lieu et Quêtes -->
                    <aside class="w-full lg:w-64 grid grid-cols-2 lg:flex lg:flex-col gap-2 lg:gap-2.5 shrink-0">
                        <!-- Lieu actuel -->
                        <div
                            class="bg-neutral-950 border border-Or-clair rounded p-2 sm:p-4 h-full lg:h-auto lg:flex-none flex flex-col"
                        >
                            <h3
                                id="aside-biome-name"
                                class="text-Or-clair text-base mb-2 shrink-0"
                            >
                                Lieu - {currentBiome.name}
                            </h3>
                            <h5
                                id="current-location"
                                class={`${currentBiome.colors.locationText} text-base font-['Almendra'] mb-2 shrink-0`}
                            >
                                Début de l'aventure
                            </h5>
                            <p
                                id="location-description"
                                class="text-white/60 text-xs overflow-y-auto"
                            >
                                {currentBiome.description}
                            </p>
                        </div>

                        <div class="hidden lg:block h-2.5 bg-neutral-950 shrink-0"></div>

                        <!-- Quêtes -->
                        <div
                            class="bg-neutral-950 border border-Or-clair rounded p-2 sm:p-4 h-full lg:h-auto lg:flex-1 lg:min-h-[200px] flex flex-col"
                        >
                            <h3 class="text-Or-clair text-base mb-2 shrink-0">Quêtes</h3>
                            <div id="quests-list" class="space-y-2 overflow-y-auto">
                                <p class="text-white/60 text-xs">
                                    En attente de quêtes...
                                </p>
                            </div>
                        </div>

                        <div class="hidden lg:block h-2.5 bg-neutral-950 shrink-0"></div>

                        <!-- Lancer de Dé -->
                        <div
                            class="bg-neutral-950 border border-Or-clair rounded p-2 sm:p-4 col-span-2 lg:col-span-1 shrink-0 flex flex-col items-center justify-center gap-2 relative overflow-hidden group cursor-pointer hover:border-orange-300 transition-colors"
                            id="dice-container"
                        >
                            <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-Or-clair/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>
                            <h3 class="text-Or-clair text-xs font-['Cinzel_Decorative'] tracking-wider uppercase z-10 transition-colors group-hover:text-orange-200">Jet de Dé</h3>
                            <div id="dice-button" class="relative z-10 w-16 h-16 sm:w-20 sm:h-20 flex items-center justify-center transition-transform duration-300 group-hover:scale-110 drop-shadow-[0_0_8px_rgba(255,233,181,0.2)] group-hover:drop-shadow-[0_0_12px_rgba(255,233,181,0.6)]">
                                <!-- Icône D20 personnalisée -->
                                <svg id="Calque_2" data-name="Calque 2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 513.88 606.83" class="w-16 h-16 sm:w-20 sm:h-20 drop-shadow-md">
                                    <polygon points="2.75 153.91 83.94 405.91 1.47 452.89 2.75 153.91" style="fill: #b7aa4e; stroke: #000; stroke-width: 10px; stroke-miterlimit: 10;"/>
                                    <polygon points="256.47 101.99 83.94 405.91 2.75 153.91 256.47 101.99" style="fill: #b5a950; stroke: #000; stroke-width: 10px; stroke-miterlimit: 10;"/>
                                    <polygon points="256.47 .89 256.47 101.99 2.75 153.91 256.47 .89" style="fill: #c6ba52; stroke: #000; stroke-width: 10px; stroke-miterlimit: 10;"/>
                                    <polygon points="511.13 153.91 256.47 101.99 256.47 .89 511.13 153.91" style="fill: #c4b957; stroke: #000; stroke-width: 10px; stroke-miterlimit: 10;"/>
                                    <polygon points="511.13 452.89 429.09 405.91 511.13 153.91 511.13 452.89" style="fill: #a09547; stroke: #000; stroke-width: 10px; stroke-miterlimit: 10;"/>
                                    <polygon points="83.94 405.91 429.09 405.91 256.47 101.99 83.94 405.91" style="fill: #a59747; stroke: #000; stroke-width: 10px; stroke-miterlimit: 10;"/>
                                    <polygon points="256.47 604.8 511.13 452.89 429.09 405.91 256.47 604.8" style="fill: #918436; stroke: #000; stroke-width: 10px; stroke-miterlimit: 10;"/>
                                    <polygon points="1.47 452.89 256.47 604.8 83.94 405.91 1.47 452.89" style="fill: #918436; stroke: #000; stroke-width: 10px; stroke-miterlimit: 10;"/>
                                    <polygon points="256.47 604.8 83.94 405.91 429.09 405.91 256.47 604.8" style="fill: #9e8e3e; stroke: #000; stroke-width: 10px; stroke-miterlimit: 10;"/>
                                    <polygon points="511.13 153.91 256.47 101.99 429.09 405.91 511.13 153.91" style="fill: #b5a950; stroke: #000; stroke-width: 10px; stroke-miterlimit: 10;"/>
                                </svg>
                                <span id="dice-result" class="absolute text-white font-['Almendra'] text-lg sm:text-xl font-bold mb-2 sm:mb-3 transition-opacity duration-300">20</span>
                            </div>
                        </div>
                    </aside>

                    <!-- Zone centrale - Chat IA et Santé -->
                    <div class="flex-1 flex flex-col gap-4 lg:gap-2.5">
                        <!-- Santé (Déplacé au-dessus du chat) -->
                        <div
                            class="bg-black/40 border border-Or-clair rounded p-3 sm:p-4 relative overflow-hidden"
                        >
                            <!-- Lueur rouge en fond -->
                            <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-red-900/20 to-transparent opacity-50 pointer-events-none"></div>

                            <div class="flex items-center justify-between mb-2 sm:mb-3 relative z-10">
                                <div class="flex items-center gap-2">
                                    <h3 class="text-Or-clair text-xs sm:text-sm font-['Cinzel_Decorative'] tracking-wider uppercase">Points de vie</h3>
                                </div>
                                <p
                                    id="health-text"
                                    class="text-red-400 text-base sm:text-lg font-['Almendra'] font-bold drop-shadow-[0_2px_4px_rgba(220,38,38,0.4)]"
                                >
                                    100 / 100
                                </p>
                            </div>

                            <!-- Barre de vie RPG stylisée -->
                            <div class="relative w-full h-3 sm:h-4 mt-1">
                                <!-- Cadre externe (bordure métallique) -->
                                <div class="absolute inset-0 rounded-[3px] border border-Or-clair/40 bg-[#0a0000] shadow-[inset_0_0_5px_rgba(0,0,0,1)] z-10 overflow-hidden">
                                    <!-- Texture de fond jauge vide -->
                                    <div class="w-full h-full opacity-10" style="background-image: repeating-linear-gradient(45deg, transparent, transparent 2px, #FFE9B5 2px, #FFE9B5 4px);"></div>
                                </div>
                                
                                <!-- Remplissage actif (le niveau de santé) -->
                                <div class="absolute inset-[1px] rounded-[2px] overflow-hidden z-20">
                                    <div
                                        id="health-bar"
                                        class="h-full bg-gradient-to-b from-red-400 via-red-600 to-red-900 transition-all duration-300 relative shadow-[0_0_10px_rgba(220,38,38,0.5)]"
                                        style="width: 100%"
                                    >
                                        <!-- Effet de reflet (verre/fiole) -->
                                        <div class="absolute top-0 inset-x-0 h-1/2 bg-gradient-to-b from-white/40 to-transparent"></div>
                                        <div class="absolute top-0 bottom-0 right-0 w-1 bg-white/50 blur-[1px]"></div>
                                    </div>
                                </div>
                                
                                <!-- Ornements superposés (embouts et graduations) -->
                                <div class="absolute inset-0 z-30 pointer-events-none flex justify-between items-center rounded-[3px] border border-black/50">
                                    <!-- Embout Gauche Doré -->
                                    <div class="w-[3px] h-full bg-gradient-to-b from-Or-clair via-[#bd943b] to-[#4a3a11]"></div>
                                    
                                    <!-- Graduations internes -->
                                    <div class="absolute inset-y-0 left-1/4 w-[1px] bg-black/60 shadow-[1px_0_0_rgba(255,233,181,0.2)]"></div>
                                    <div class="absolute inset-y-0 left-2/4 w-[1px] bg-black/60 shadow-[1px_0_0_rgba(255,233,181,0.2)]"></div>
                                    <div class="absolute inset-y-0 left-3/4 w-[1px] bg-black/60 shadow-[1px_0_0_rgba(255,233,181,0.2)]"></div>
                                    
                                    <!-- Embout Droit Doré -->
                                    <div class="w-[3px] h-full bg-gradient-to-b from-Or-clair via-[#bd943b] to-[#4a3a11]"></div>
                                </div>
                                
                                <!-- Cadre extérieur ultra-fin pour la finition -->
                                <div class="absolute -inset-[1px] rounded-[4px] border border-Or-clair/20 pointer-events-none z-40"></div>
                            </div>
                        </div>

                        <!-- Chat IA -->
                        <div
                            id="chat-container"
                            class={`h-[60vh] min-h-[400px] lg:h-[600px] lg:min-h-0 w-full ${currentBiome.colors.chatBg} rounded-[5px] border border-Or-clair shadow-[0px_4px_4px_0px_rgba(0,0,0,0.25)] flex flex-col relative`}
