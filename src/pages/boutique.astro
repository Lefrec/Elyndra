      image: "https://copilot.microsoft.com/th/id/BCO.4ae63c68-22e2-4def-b18a-58f3e3236918.png",
      powers: ["Pas Fantôme : Invisibilité totale pendant 8 secondes", "Exécution Silencieuse : Coup critique instantané dans le dos", "Lames Empoisonnées : Dégâts sur la durée mortels"],
      stats: { attack: 95, defense: 50, magic: 40, speed: 100 }
    },
    {
      id: 4, name: "Pyraxis le Dévoreur", title: "Élémentaliste de Feu", rarity: "Épique", credits: 1200, price: 19.99,
      description: "Incarnation vivante du feu primordial, Pyraxis brûle tout sur son passage et peut transformer son corps en flammes pures.",
      image: "https://copilot.microsoft.com/th/id/BCO.82d77312-022d-475a-b4cc-4bc7aa058797.png",
      powers: ["Forme Élémentaire : Transforme le corps en feu, immune aux attaques physiques", "Nova Incendiaire : Explosion massive de flammes", "Chaînes de Magma : Emprisonne et brûle plusieurs ennemis"],
      stats: { attack: 90, defense: 65, magic: 88, speed: 70 }
    },
    {
      id: 5, name: "Morven le Sépulcral", title: "Nécromancien Suprême", rarity: "Légendaire", credits: 1500, price: 24.99,
      description: "Seigneur des morts-vivants qui commande une armée de créatures spectrales et peut drainer la force vitale de ses ennemis.",
      image: "https://copilot.microsoft.com/th/id/BCO.e6c38b32-8a99-4ca6-b6ac-9a1b3aad890d.png",
      powers: ["Armée des Damnés : Invoque 5 guerriers morts-vivants", "Drain de Vie : Absorbe la vie des ennemis pour se soigner", "Malédiction de Décomposition : Affaiblit tous les ennemis proches"],
      stats: { attack: 75, defense: 70, magic: 92, speed: 60 }
    },
    {
      id: 6, name: "Aurelia la Radieuse", title: "Paladine Céleste", rarity: "Épique", credits: 1200, price: 19.99,
      description: "Championne de la lumière divine, Aurelia protège ses alliés avec des barrières sacrées et peut ressusciter les tombés au combat.",
      image: "https://copilot.microsoft.com/th/id/BCO.eee1f523-890a-4f3a-aa0d-177e1b86e60d.png",
      powers: ["Résurrection Divine : Ramène un allié à la vie avec 50% HP", "Jugement Sacré : Dégâts massifs aux créatures corrompues", "Aura de Protection : Réduit les dégâts de tous les alliés de 40%"],
      stats: { attack: 80, defense: 90, magic: 85, speed: 65 }
    }
  ];

  // Données des DLC
  const dlcData = [
    {
      id: 1, title: "Les Légendes Oubliées", description: "Découvrez l'histoire ancienne d'Elyndra à travers des quêtes épiques. Rencontrez les héros légendaires du passé et révélez les secrets de ce monde mystique.", price: 14.99, credits: 800, image: "https://images.unsplash.com/photo-1766879240548-f8ae84ef6e68?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxteXN0aWNhbCUyMGZhbnRhc3klMjB3b21hbiUyMHBvcnRyYWl0JTIwZGFya3xlbnwxfHx8fDE3NzI3MjIzMjh8MA&ixlib=rb-4.1.0&q=80&w=1080", isNew: true, featured: true
    },
    {
      id: 2, title: "Les Profondeurs d'Azurea", description: "Plongez dans les océans mystérieux d'Elyndra et explorez le royaume sous-marin d'Azurea. Découvrez des créatures aquatiques légendaires et maîtrisez les pouvoirs de l'eau.", price: 16.99, credits: 900, image: "https://images.unsplash.com/photo-1685908359279-abe004f8fbfe?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHx1bmRlcndhdGVyJTIwb2NlYW4lMjBmYW50YXN5JTIwd29ybGR8ZW58MXx8fHwxNzcyNzIzMTAzfDA&ixlib=rb-4.1.0&q=80&w=1080", isNew: true, featured: true
    },
    {
      id: 3, title: "Les Monts Volcaniques", description: "Affrontez les dangers des volcans d'Elyndra où règne la chaleur infernale. Domptez le feu primordial et découvrez les forges ancestrales des titans.", price: 13.99, credits: 750, image: "https://images.unsplash.com/photo-1760293877739-793b24020ff1?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHx2b2xjYW5pYyUyMGxhdmElMjBtb3VudGFpbnMlMjBmaXJlfGVufDF8fHx8MTc3MjcyMzEwNHww&ixlib=rb-4.1.0&q=80&w=1080", isNew: true, featured: false
    },
    {
      id: 4, title: "Neon Dreams", description: "Explorez les cités futuristes d'Elyndra dans cette extension cyberpunk. Nouvelles factions, personnages et choix narratifs qui changeront l'avenir du royaume.", price: 12.99, credits: 650, image: "https://images.unsplash.com/photo-1688377051459-aebb99b42bff?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxjeWJlcnB1bmslMjBuZW9uJTIwY2l0eSUyMG5pZ2h0fGVufDF8fHx8MTc3MjY2NDM5OHww&ixlib=rb-4.1.0&q=80&w=1080", isNew: false, featured: false
    },
    {
      id: 5, title: "La Forêt Éternelle", description: "Aventurez-vous dans les terres sauvages d'Elyndra où la magie primordiale règne. Rencontrez les gardiens ancestraux et domptez les forces de la nature.", price: 9.99, credits: 500, image: "https://images.unsplash.com/photo-1763321402439-41eb2a0c7e7b?crop=entropy&cs=tinysrgb&fit=max&fm=jpg&ixid=M3w3Nzg4Nzd8MHwxfHNlYXJjaHwxfHxteXN0ZXJpb3VzJTIwZXRoZXJlYWwlMjBmb3Jlc3QlMjBuaWdodHxlbnwxfHx8fDE3NzI3MjIzMjl8MA&ixlib=rb-4.1.0&q=80&w=1080", isNew: false, featured: false
    },
  ];

  // Données des packs de crédits
  const creditPacks = [
    { name: "Starter", credits: 500, price: "4,99€", image: "/src/assets/starter-pack.svg" },
    { name: "Pack Standard", credits: 1200, price: "9,99€", image: "/src/assets/pack-standard.svg" },
    { name: "Pack Premium", credits: 2500, price: "19,99€", image: "/src/assets/pack-premium.svg" },
    { name: "Pack Elite", credits: 6000, price: "44,99€", image: "/src/assets/pack-elite.svg" }
  ];

  // Fonction pour ajouter au panier
  function addToCart(item, type) {
    const cart = JSON.parse(localStorage.getItem('elyndra_cart') || '[]');
    const existingItem = cart.find(cartItem => cartItem.type === type && (cartItem.id === item.id || cartItem.name === item.name));
    
    if (existingItem) {
      existingItem.quantity += 1;
    } else {
      const cartItem = { ...item, type, quantity: 1 };
      if (type === 'credit') {
        cartItem.price = parseFloat(item.price.replace(',', '.').replace('€', ''));
      }
      cart.push(cartItem);
    }
    
    localStorage.setItem('elyndra_cart', JSON.stringify(cart));
    showNotification(`${item.name || item.title} ajouté au panier !`);
    // Dispatch event pour mettre à jour le header
    window.dispatchEvent(new Event('cartUpdated'));
  }

  // Écouteurs d'événements
  document.addEventListener('click', (e) => {
    if (e.target.matches('[data-char-id]')) {
      const id = parseInt(e.target.dataset.charId);
      const character = characters.find(c => c.id === id);
      if (character) {
        addToCart(character, 'character');
      }
    } else if (e.target.matches('[data-dlc-id]')) {
      const id = parseInt(e.target.dataset.dlcId);
      const dlc = dlcData.find(d => d.id === id);
      if (dlc) {
        addToCart(dlc, 'dlc');
      }
    } else if (e.target.matches('[data-credit-name]')) {
      const name = e.target.dataset.creditName;
      const creditPack = creditPacks.find(c => c.name === name);
      if (creditPack) {
        addToCart(creditPack, 'credit');
      }
    }
  });
</script>

</Layout>