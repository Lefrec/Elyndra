---
import Layout from "../../layout/Layout.astro";
import "/src/styles/global.css";
import lunel from "../../assets/biomes/lunel.webp";
import solarys from "../../assets/biomes/solarys.webp";
import auralis from "../../assets/biomes/auralis.webp";
import elyndra from "../../assets/biomes/elyndra.webp";
import coeurIcon from "../../assets/interface_ia/coeur.svg";

// Récupérer le paramètre de biome depuis l'URL
const { biome } = Astro.params;

// Configuration des biomes
const biomesConfig = {
    lunel: {
        name: "Lunel",
        fullName: "Le Cœur Sylvestre de Lunel",
        description: "Une jungle oppressante avec des cités perchées",
        image: lunel,
        colors: {
            primary: "text-green-200/95",
            bgGradient:
                "bg-[radial-gradient(ellipse_50.00%_50.00%_at_50.00%_50.00%,_#1F3F0D_0%,_#010700_100%)]",
            chatBg: "bg-[radial-gradient(ellipse_50.00%_50.00%_at_50.00%_50.00%,_#002307_0%,_#001D07_50%,_#001005_100%)]",
            messageBg: "bg-green-950",
            messageText: "text-green-300",
            locationText: "text-green-300",
            buttonBg: "bg-green-800",
            buttonHover: "hover:bg-green-700",
            svgPrimary: "#5AB061",
            svgSecondary: "#113003",
            svgGradientLight: "#7CF885",
            svgGradientDark: "#509555",
            svgStroke: "#234324",
        },
        startPrompt:
            "Je commence mon aventure dans la forêt du cœur sylvestre de Lunel",
    },
    solarys: {
        name: "Solarys",
        fullName: "Les Dunes ardentes de Solarys",
        description: "Une immensité aride avec un oasis solitaire",
        image: solarys,
        colors: {
            primary: "text-orange-200/95",
            bgGradient:
                "bg-[radial-gradient(ellipse_50.00%_50.00%_at_50.00%_50.00%,_#3F2D0D_0%,_#0A0700_100%)]",
            chatBg: "bg-[radial-gradient(ellipse_50.00%_50.00%_at_50.00%_50.00%,_#231007_0%,_#1D0C07_50%,_#100500_100%)]",
            messageBg: "bg-orange-950",
            messageText: "text-orange-300",
            locationText: "text-orange-300",
            buttonBg: "bg-orange-800",
            buttonHover: "hover:bg-orange-700",
            svgPrimary: "#FF8C42",
            svgSecondary: "#8B4513",
            svgGradientLight: "#FFB088",
            svgGradientDark: "#D97742",
            svgStroke: "#4A2511",
        },
        startPrompt:
            "Je commence mon aventure dans les dunes ardentes de Solarys",
    },
    auralis: {
        name: "Auralis",
        fullName: "Le Village Gelé d'Auralis",
        description: "Un refuge givré avec des vents mordants",
        image: auralis,
        colors: {
            primary: "text-blue-200/95",
            bgGradient:
                "bg-[radial-gradient(ellipse_50.00%_50.00%_at_50.00%_50.00%,_#0D1F3F_0%,_#000107_100%)]",
            chatBg: "bg-[radial-gradient(ellipse_50.00%_50.00%_at_50.00%_50.00%,_#071023_0%,_#070D1D_50%,_#050010_100%)]",
            messageBg: "bg-blue-950",
            messageText: "text-blue-300",
            locationText: "text-blue-300",
            buttonBg: "bg-blue-800",
            buttonHover: "hover:bg-blue-700",
            svgPrimary: "#5AB0FF",
            svgSecondary: "#001133",
            svgGradientLight: "#7CC8FF",
            svgGradientDark: "#5095D9",
            svgStroke: "#243447",
        },
        startPrompt: "Je commence mon aventure dans le village gelé d'Auralis",
    },
    elyndra: {
        name: "Élyndra",
        fullName: "Les Ruines Oubliées d'Élyndra",
        description: "Une cité perdue avec des pierres runiques",
        image: elyndra,
        colors: {
            primary: "text-purple-200/95",
            bgGradient:
                "bg-[radial-gradient(ellipse_50.00%_50.00%_at_50.00%_50.00%,_#2D0D3F_0%,_#07000A_100%)]",
            chatBg: "bg-[radial-gradient(ellipse_50.00%_50.00%_at_50.00%_50.00%,_#100723_0%,_#0D071D_50%,_#050010_100%)]",
            messageBg: "bg-purple-950",
            messageText: "text-purple-300",
            locationText: "text-purple-300",
            buttonBg: "bg-purple-800",
            buttonHover: "hover:bg-purple-700",
            svgPrimary: "#9D5AFF",
            svgSecondary: "#330044",
            svgGradientLight: "#C88FFF",
            svgGradientDark: "#8550D9",
            svgStroke: "#472447",
        },
        startPrompt:
            "Je commence mon aventure au milieu des Ruines oubliées d'Élyndra",
    },
};

// Vérifier si le biome existe, sinon rediriger ou utiliser un biome par défaut
const currentBiome =
    biomesConfig[biome as keyof typeof biomesConfig] || biomesConfig.lunel;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>Elyndra</title>
    </head>

    <div class="min-h-screen bg-neutral-950">
        <!-- Bandeau d'incitation à la connexion -->
        <div class="w-full flex justify-center">
            <div
                class="h-11 px-3 py-5 bg-zinc-800/75 rounded-bl-2xl rounded-br-2xl inline-flex justify-center items-center overflow-hidden"
            >
                <a
                    href="/login"
                    class="justify-start text-Or-clair text-sm font-normal underline leading-5"
                >
                    Connectez
                </a>
                <div
                    class="justify-start text-white/60 text-sm font-normal leading-5"
                >
                    -vous pour sauvegarder votre partie
                </div>
            </div>
        </div>

        <!-- En-tête du biome -->
        <header
            class="w-full mx-auto h-30 px-4 md:px-24 flex justify-between items-center relative"
        >
            <button
                id="verbomnes-button"
                class={`px-4 py-3.5 ${currentBiome.colors.buttonBg} ${currentBiome.colors.buttonHover} transition-colors rounded-[10px] flex justify-center items-center`}
            >
                <span class="text-white text-base">Vos Verbomnes</span>
            </button>

            <div class="flex flex-col justify-center items-center">
                <h1
                    class={`absolute left-1/2 -translate-x-1/2 text-center ${currentBiome.colors.primary} text-4xl md:text-6xl font-bold font-['Cinzel_Decorative']`}
                >
                    {currentBiome.name}
                </h1>
            </div>

            <!-- Menu hamburger avec SVG -->
            <button
                id="menu-toggle"
                class="px-4 py-4 bg-zinc-950 hover:bg-zinc-900 transition-colors rounded flex justify-center items-center z-50 relative group"
            >
                <img
                    src="/menu-hamburger.svg"
                    alt="Menu"
                    class="w-8 h-6 transition-transform duration-300 group-hover:scale-110"
                    id="burger-icon"
                />
            </button>
        </header>

        <!-- Modal Verbomnes -->
        <div
            id="verbomnes-modal"
            class="fixed inset-0 bg-black/70 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300 z-50"
        >
            <div
                class="relative bg-black border-2 border-Or-clair rounded-lg shadow-2xl max-w-4xl w-full mx-4 p-10 transform scale-95 transition-transform duration-300"
            >
                <!-- Bouton fermer -->
                <button
                    id="close-verbomnes"
                    class="absolute top-6 right-6 w-8 h-8 border-2 border-Or-clair hover:bg-Or-clair/20 transition-colors flex items-center justify-center"
                >
                    <span class="text-Or-clair text-xl">×</span>
                </button>

                <!-- Titre -->
                <div class="mb-6">
                    <h2
                        class="text-Or-clair text-4xl font-['Cinzel_Decorative'] uppercase text-center tracking-[3px] mb-4"
                    >
                        L'Oracle des Verbomnes
                    </h2>
                    <div class="flex justify-center items-center gap-3">
                        <div
                            class="w-24 h-px bg-gradient-to-r from-transparent via-orange-200 to-transparent"
                        >
                        </div>
                        <div class="w-1 h-1 bg-orange-200 rounded-full"></div>
                        <div
                            class="w-24 h-px bg-gradient-to-r from-transparent via-orange-200 to-transparent"
                        >
                        </div>
                    </div>
                </div>

                <!-- Description -->
                <p
                    class="text-center text-white text-base font-['Almendra'] tracking-wide mb-8"
                >
                    Chaque parole façonne le destin. Mais même les dieux ont
                    leurs limites.
                </p>

                <!-- Contenu principal -->
                <div
                    class="flex flex-col md:flex-row gap-12 items-center justify-center mb-8"
                >
                    <!-- Compteur de Verbomnes -->
                    <div class="relative flex items-center justify-center">
                        <!-- Cercle décoratif -->
                        <div
                            class="absolute w-72 h-72 border border-Or-clair opacity-30 rounded-full shadow-[0px_4px_15px_0px_rgba(255,233,181,0.5)]"
                        >
                        </div>
                        <div
                            class="absolute w-60 h-56 border border-Or-clair opacity-20"
                        >
                        </div>

                        <!-- Nombre et texte -->
                        <div class="relative text-center z-10">
                            <div
                                class="text-Or-clair text-6xl font-['Cinzel_Decorative'] leading-[96px] mb-2"
                            >
                                128
                            </div>
                            <div
                                class="text-orange-200 text-base tracking-widest"
                            >
                                Verbomnes restants
                            </div>
                        </div>
                    </div>

                    <!-- Explications -->
                    <div class="max-w-md space-y-6">
                        <div>
                            <h3
                                class="text-Or-clair text-lg tracking-wide mb-3"
                            >
                                L'Oracle murmure encore
                            </h3>
                            <p class="text-white text-sm leading-5">
                                Chaque action formulée par le joueur invoque
                                l'Oracle. Lorsque toutes les Verbomnes ont été
                                consommées, le récit ne peut plus se poursuivre.
                            </p>
                        </div>
                        <div>
                            <p class="text-white text-sm leading-5">
                                L'Oracle d'Elyndra est animé par une
                                intelligence artificielle de génération de
                                langage, agissant comme narrateur dynamique dans
                                un univers et des règles définis par les
                                créateurs.
                            </p>
                        </div>

                        <!-- Bouton membre -->
                        <a
                            href="/"
                            class="w-full px-4 py-3 bg-yellow-700 hover:bg-yellow-600 transition-colors rounded-[10px] text-center"
                        >
                            <span class="text-white text-xs"
                                >Découvrez nos offres pour plus de Verbomnes !</span
                            >
                        </a>
                    </div>
                </div>

                <!-- Footer -->
                <div class="text-center mb-4">
                    <p class="text-Or-clair text-sm tracking-wide">
                        Technologie fournie par Perplexity
                    </p>
                </div>

                <!-- Séparateur final -->
                <div class="flex justify-center items-center gap-3.5">
                    <div
                        class="w-24 h-px bg-gradient-to-r from-transparent via-orange-200 to-transparent"
                    >
                    </div>
                    <div class="w-1 h-1 bg-orange-200 rounded-full"></div>
                    <div
                        class="w-24 h-px bg-gradient-to-r from-transparent via-orange-200 to-transparent"
                    >
                    </div>
                </div>
            </div>
        </div>

        <!-- Menu latéral -->
        <nav
            id="side-menu"
            class="fixed top-0 right-0 h-full w-80 bg-neutral-950 border-l border-Or-clair shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out z-40 overflow-y-auto"
        >
            <div class="p-6">
                <!-- Bouton fermer en haut à droite -->
                <button
                    id="close-menu"
                    class="absolute top-4 right-4 w-10 h-10 flex items-center justify-center bg-zinc-900 hover:bg-zinc-800 rounded transition-colors group"
                >
                    <span
                        class="text-Or-clair text-3xl leading-none group-hover:scale-110 transition-transform"
                        >×</span
                    >
                </button>

                <!-- En-tête du menu -->
                <div class="mb-8 pb-4 border-b border-Or-clair/30">
                    <h2 class="text-Or-clair text-2xl">Menu</h2>
                </div>

                <!-- Navigation -->
                <ul class="space-y-4">
                    <li>
                        <a
                            href="/#"
                            class="block px-4 py-3 text-white hover:text-Or-clair hover:bg-zinc-900 rounded transition-colors"
                        >
                            Accueil
                        </a>
                    </li>
                    <li>
                        <a
                            href="/choixbiome"
                            class="block px-4 py-3 text-white hover:text-Or-clair hover:bg-zinc-900 rounded transition-colors"
                        >
                            Changer de Biome
                        </a>
                    </li>
                    <li>
                        <button
                            class="w-full text-left px-4 py-3 text-white hover:text-Or-clair hover:bg-zinc-900 rounded transition-colors"
                        >
                            💾 Sauvegarder
                        </button>
                    </li>
                    <li>
                        <button
                            class="w-full text-left px-4 py-3 text-white hover:text-Or-clair hover:bg-zinc-900 rounded transition-colors"
                        >
                            ⚙️ Paramètres
                        </button>
                    </li>
                </ul>

                <!-- Biomes disponibles -->
                <div class="mt-8 pt-6 border-t border-Or-clair/30">
                    <h3 class="text-Or-clair text-lg mb-4">Biomes</h3>
                    <div class="space-y-2">
                        <a
                            href="/interface_jeu/lunel"
                            class="block px-4 py-2 text-green-300 hover:bg-green-950/50 rounded transition-colors text-sm"
                        >
                            🌳 Lunel
                        </a>
                        <a
                            href="/interface_jeu/solarys"
                            class="block px-4 py-2 text-orange-300 hover:bg-orange-950/50 rounded transition-colors text-sm"
                        >
                            🏜️ Solarys
                        </a>
                        <a
                            href="/interface_jeu/auralis"
                            class="block px-4 py-2 text-blue-300 hover:bg-blue-950/50 rounded transition-colors text-sm"
                        >
                            ❄️ Auralis
                        </a>
                        <a
                            href="/interface_jeu/elyndra"
                            class="block px-4 py-2 text-purple-300 hover:bg-purple-950/50 rounded transition-colors text-sm"
                        >
                            🏛️ Élyndra
                        </a>
                    </div>
                </div>

                <!-- Retour -->
                <div class="mt-8 pt-6 border-t border-Or-clair/30">
                    <a
                        href="/"
                        class="block w-full text-center px-4 py-3 bg-red-900 hover:bg-red-800 text-white rounded transition-colors"
                    >
                        ← Quitter l'aventure
                    </a>
                </div>
            </div>
        </nav>

        <!-- Overlay pour fermer le menu -->
        <div
            id="menu-overlay"
            class="fixed inset-0 bg-black/50 opacity-0 pointer-events-none transition-opacity duration-300 z-30"
        >
        </div>

        <!-- Interface principale -->
        <main class="px-2.5 pb-4">
            <div
                class={`max-w-[1400px] mx-auto ${currentBiome.colors.bgGradient} rounded-md border border-Or-clair p-2.5`}
            >
                <div class="flex flex-col lg:flex-row gap-2.5 min-h-[705px]">
                    <!-- Panneau gauche - Lieu et Quêtes -->
                    <aside class="w-full lg:w-64 flex flex-col gap-2.5">
                        <!-- Lieu actuel -->
                        <div
                            class="bg-neutral-950 border border-Or-clair rounded p-4"
                        >
                            <h3 class="text-Or-clair text-base mb-2">
                                Lieu - {currentBiome.name}
                            </h3>
                            <h5
                                id="current-location"
                                class={`${currentBiome.colors.locationText} text-base font-['Almendra'] mb-2`}
                            >
                                Début de l'aventure
                            </h5>
                            <p
                                id="location-description"
                                class="text-white/60 text-xs"
                            >
                                {currentBiome.description}
                            </p>
                        </div>

                        <div class="h-2.5 bg-neutral-950"></div>

                        <!-- Quêtes -->
                        <div
                            class="bg-neutral-950 border border-Or-clair rounded p-4 flex-1"
                        >
                            <h3 class="text-Or-clair text-base mb-2">Quêtes</h3>
                            <div id="quests-list" class="space-y-2">
                                <p class="text-white/60 text-xs">
                                    En attente de quêtes...
                                </p>
                            </div>
                        </div>
                    </aside>

                    <!-- Zone centrale - Chat IA -->
                    <div
                        class={`flex-1 ${currentBiome.colors.chatBg} rounded-[5px] border border-Or-clair shadow-[0px_4px_4px_0px_rgba(0,0,0,0.25)] flex flex-col relative`}
                    >
                        <!-- Zone de messages (scrollable) -->
                        <div
                            id="chat-messages"
                            class="flex-1 overflow-y-auto p-4 space-y-4 pb-20 border-Or-clair rounded-tl-[5px] rounded-tr-[5px]"
                        >
                            <!-- Les messages seront ajoutés ici dynamiquement -->
                        </div>

                        <!-- Barre de saisie (fixée en bas) -->
                        <div
                            class="absolute bottom-0 left-0 right-0 p-4 bg-transparent"
                        >
                            <div class="flex items-center gap-2">
                                <input
                                    type="text"
                                    id="user-input"
                                    placeholder="Que faites-vous ?"
                                    class="flex-1 px-4 py-3 bg-[radial-gradient(ellipse_50.00%_50.00%_at_50.00%_50.00%,_#D1BF94_0%,_#A39571_100%)] border border-amber-900/50 rounded-l-[10px] text-black text-base font-['Almendra'] placeholder-black/50 focus:outline-none focus:ring-2 focus:ring-Or-clair"
                                />
                                <button
                                    id="send-button"
                                    class="px-6 py-3 bg-[radial-gradient(ellipse_50.00%_50.00%_at_50.00%_50.00%,_#BC7D46_0%,_#B3743C_100%)] hover:bg-[radial-gradient(ellipse_50.00%_50.00%_at_50.00%_50.00%,_#CC8D56_0%,_#C3844C_100%)] transition-colors border border-stone-950/50 rounded-r-[10px] text-white"
                                >
                                    Envoyer
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Panneau droit - Stats et Inventaire -->
                    <aside
                        class="w-full lg:w-64 border border-Or-clair rounded flex flex-col gap-2.5 p-2"
                    >
                        <!-- Santé -->
                        <div
                            class="bg-gray-950 border border-Or-clair rounded p-3"
                        >
                            <div class="flex items-center gap-2 mb-2">
                                <div
                                    class="w-5 h-5 flex items-center justify-center"
                                >
                                    <img
                                        src={coeurIcon.src}
                                        alt="Santé"
                                        class="w-4 h-4"
                                    />
                                </div>
                                <h3 class="text-white/90 text-base">Santé</h3>
                            </div>
                            <div
                                class="bg-black/40 rounded-full border border-red-900/50 p-0.5 mb-2"
                            >
                                <div
                                    id="health-bar"
                                    class="h-2.5 bg-gradient-to-r from-red-950 to-red-800 rounded-full"
                                    style="width: 85%"
                                >
                                </div>
                            </div>
                            <p
                                id="health-text"
                                class="text-white/80 text-base font-['Almendra'] text-right"
                            >
                                85 / 100
                            </p>
                        </div>

                        <!-- Statistiques -->
                        <div class="text-center relative">
                            <h3 class="text-white text-xs mb-2">
                                Statistiques
                            </h3>

                            <!-- SVG avec les stats intégrées -->
                            <svg
                                class="w-full h-auto"
                                viewBox="0 0 235 335"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                            >
                                <!-- Définitions des gradients -->
                                <defs>
                                    <!-- Gradients pour le bouclier -->
                                    <linearGradient
                                        id="shield-a"
                                        x1="33.264"
                                        y1="20.477"
                                        x2="18.373"
                                        y2="20.477"
                                        gradientUnits="userSpaceOnUse"
                                    >
                                        <stop
                                            stop-color={currentBiome.colors
                                                .svgGradientLight}></stop>
                                        <stop
                                            offset="1"
                                            stop-color={currentBiome.colors
                                                .svgGradientDark}></stop>
                                    </linearGradient>
                                    <linearGradient
                                        id="shield-b"
                                        x1="2.985"
                                        y1="19.484"
                                        x2="33.76"
                                        y2="18.987"
                                        gradientUnits="userSpaceOnUse"
                                    >
                                        <stop
                                            stop-color={currentBiome.colors
                                                .svgSecondary}></stop>
                                        <stop
                                            offset="1"
                                            stop-color={currentBiome.colors
                                                .svgGradientDark}></stop>
                                    </linearGradient>
                                    <!-- Gradients pour les séparations -->
                                    <linearGradient
                                        id="sep-a"
                                        x1="107.216"
                                        y1="62.051"
                                        x2="192.592"
                                        y2="62.051"
                                        gradientUnits="userSpaceOnUse"
                                    >
                                        <stop stop-color="#FFE9B5"></stop>
                                        <stop
                                            offset="1"
                                            stop-color="#FFE9B5"
                                            stop-opacity=".1"></stop>
                                    </linearGradient>
                                    <linearGradient
                                        id="sep-b"
                                        x1="0"
                                        y1="62.051"
                                        x2="92.325"
                                        y2="62.051"
                                        gradientUnits="userSpaceOnUse"
                                    >
                                        <stop
                                            stop-color="#FFE9B5"
                                            stop-opacity=".1"></stop>
                                        <stop offset="1" stop-color="#FFE9B5"
                                        ></stop>
                                    </linearGradient>
                                    <linearGradient
                                        id="sep-c"
                                        x1="100.714"
                                        y1="53.609"
                                        x2="100.803"
                                        y2=".002"
                                        gradientUnits="userSpaceOnUse"
                                    >
                                        <stop stop-color="#FFE9B5"></stop>
                                        <stop
                                            offset="1"
                                            stop-color="#FFE9B5"
                                            stop-opacity=".1"></stop>
                                    </linearGradient>
                                    <linearGradient
                                        id="sep-d"
                                        x1="107.216"
                                        y1="134.522"
                                        x2="192.592"
                                        y2="134.522"
                                        gradientUnits="userSpaceOnUse"
                                    >
                                        <stop stop-color="#FFE9B5"></stop>
                                        <stop
                                            offset="1"
                                            stop-color="#FFE9B5"
                                            stop-opacity=".1"></stop>
                                    </linearGradient>
                                    <linearGradient
                                        id="sep-e"
                                        x1="0"
                                        y1="134.522"
                                        x2="92.325"
                                        y2="134.522"
                                        gradientUnits="userSpaceOnUse"
                                    >
                                        <stop
                                            stop-color="#FFE9B5"
                                            stop-opacity=".1"></stop>
                                        <stop offset="1" stop-color="#FFE9B5"
                                        ></stop>
                                    </linearGradient>
                                    <linearGradient
                                        id="sep-f"
                                        x1="107.216"
                                        y1="206.992"
                                        x2="192.592"
                                        y2="206.992"
                                        gradientUnits="userSpaceOnUse"
                                    >
                                        <stop stop-color="#FFE9B5"></stop>
                                        <stop
                                            offset="1"
                                            stop-color="#FFE9B5"
                                            stop-opacity=".1"></stop>
                                    </linearGradient>
                                    <linearGradient
                                        id="sep-g"
                                        x1="0"
                                        y1="206.992"
