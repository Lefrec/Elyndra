---
import { parse } from "astro:schema";
import Layout from "../layout/Layout.astro";

let user;

if (Astro.locals.pb.authStore.record) {
  user = Astro.locals.pb.authStore.record;
}

if (Astro.request.method === "POST") {
  const data = await Astro.request.formData();
  if (data.has("deconnexion")) {
    Astro.locals.pb.authStore.clear();
    Astro.response.headers.append(
      "set-cookie",
      Astro.locals.pb.authStore.exportToCookie()
    );
    return Astro.redirect("/login");
  };
  try {
    if (data.has("name")) {
        const name = data.get("name") as string;
        const email = data.get("email") as string;
        await Astro.locals.pb.collection("users").update(user.id, {email, name});
    }
    if (data.has("password")) {
        const oldPassword = data.get("oldPassword") as string;
        const password = data.get("password") as string;
        const passwordConfirm = data.get("passwordConfirm") as string;
        if (password == passwordConfirm) {
            await Astro.locals.pb.collection("users").update(user.id, {oldPassword, password, passwordConfirm});
        }
        await Astro.locals.pb.collection("users").authWithPassword(user.email, password);
    }
    return Astro.redirect("/profile");
  } catch (e) {
    console.log("Login failed",e);
  }
}
---

<Layout title="Mon Profil - Elyndra">
    <div class="min-h-screen bg-Background-dark-blue text-white py-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto space-y-8">
            
            <!-- En-tête -->
            <div>
                <h1 class="text-3xl font-bold font-heading text-Or-clair tracking-wider uppercase">Mon Profil</h1>
                <p class="mt-2 text-sm text-gray-400 font-body">Gérez vos informations personnelles, votre sécurité et vos achats.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                
                <!-- Menu latéral -->
                <div class="col-span-1 space-y-2 font-body">
                    <a href="#general" class="block px-4 py-3 rounded-lg bg-neutral-900 border-l-4 border-Or-clair text-Or-clair font-medium transition-colors">
                        Informations générales
                    </a>
                    <a href="#security" class="block px-4 py-3 rounded-lg hover:bg-neutral-900 text-gray-400 hover:text-Or-clair transition-colors">
                        Sécurité
                    </a>
                    <a href="#billing" class="block px-4 py-3 rounded-lg hover:bg-neutral-900 text-gray-400 hover:text-Or-clair transition-colors">
                        Historique de paiement
                    </a>
                    
                    <div class="pt-6 border-t border-neutral-800 mt-4">
                        <!-- Remplacez le header de l'action vers votre véritable point de terminaison de déconnexion -->
                        <form method="post">
                            <input type="hidden" value="1" name="deconnexion" />
                            <button type="submit" class="w-full text-left px-4 py-3 rounded-lg hover:bg-red-950/50 text-white hover:text-red-400 transition-colors flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                                </svg>
                                Se déconnecter
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Section de Contenu -->
                <div class="col-span-1 md:col-span-3 space-y-10">
                    
                    <!-- Formulaire : Informations Générales -->
                    <section id="general" class="relative group">
                        <!-- Fond gradient style Cards -->
                        <div class="absolute inset-0 bg-gradient-to-br from-amber-100/30 to-amber-100/10 rounded-2xl -m-0.5"></div>
                        <div class="relative bg-slate-950/80 p-6 md:p-8 rounded-2xl border border-amber-100/20 shadow-xl">
                            <h2 class="text-xl font-heading text-Or-clair mb-6">Informations Générales</h2>
                            
                            <form class="space-y-5 font-body" method="post">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                                <div>
                                    <label class="block text-sm font-medium text-gray-300 mb-1.5">Pseudonyme</label>
                                    <input type="text" name="name" value={user.name || ''} 
                                        class="w-full px-4 py-2.5 bg-neutral-950 border border-neutral-700 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 text-white outline-none transition-shadow" placeholder="Votre pseudo" />
                                </div>
                                <div>
                                    <label class="block text-sm font-medium text-gray-300 mb-1.5">Adresse Email</label>
                                    <input type="email" name="email" value={user.email || ''} 
                                        class="w-full px-4 py-2.5 bg-neutral-950 border border-neutral-700 rounded-lg focus:ring-2 focus:ring-elyndra-3 focus:border-elyndra-3 text-white outline-none transition-shadow" placeholder="exemple@email.com" />
                                </div>
                            </div>
                            
                            <div class="pt-4 flex justify-start">
                                <button type="submit" class="px-6 py-2.5 bg-elyndra-3 hover:opacity-90 text-white rounded-[10px] transition-opacity font-semibold text-sm">
                                    Sauvegarder les modifications
                                </button>
                            </div>
                        </form>
                        </div>
                    </section>

                    <!-- Formulaire : Sécurité -->
                    <section id="security" class="relative group">
                        <!-- Fond gradient style Cards -->
                        <div class="absolute inset-0 bg-gradient-to-br from-amber-100/30 to-amber-100/10 rounded-2xl -m-0.5"></div>
                        <div class="relative bg-slate-950/80 p-6 md:p-8 rounded-2xl border border-amber-100/20 shadow-xl">
                            <h2 class="text-xl font-heading text-Or-clair mb-6">Sécurité</h2>
                            
                            <form class="space-y-5 font-body max-w-md" method="post">
                            <div>
                                <label class="block text-sm font-medium text-gray-300 mb-1.5">Ancien mot de passe</label>
                                <input type="password" name="oldPassword" 
                                    class="w-full px-4 py-2.5 bg-neutral-950 border border-neutral-700 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 text-white outline-none transition-shadow" placeholder="••••••••" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-300 mb-1.5">Nouveau mot de passe</label>
                                <input type="password" name="password" 
                                    class="w-full px-4 py-2.5 bg-neutral-950 border border-neutral-700 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 text-white outline-none transition-shadow" placeholder="••••••••" />
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-300 mb-1.5">Confirmer le nouveau mot de passe</label>
                                <input type="password" name="passwordConfirm" 
                                    class="w-full px-4 py-2.5 bg-neutral-950 border border-neutral-700 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 text-white outline-none transition-shadow" placeholder="••••••••" />
                            </div>
                            
                            <div class="pt-4">
                                <button type="submit" class="px-6 py-2.5 bg-elyndra-3 hover:opacity-90 text-white rounded-[10px] transition-opacity font-semibold text-sm shadow-[0_0_15px_rgba(217,119,66,0.3)]">
                                    Mettre à jour le mot de passe
                                </button>
                            </div>
                        </form>
                        </div>
                    </section>

                    <!-- Historique de paiement -->
                    <section id="billing" class="relative group">
                        <!-- Fond gradient style Cards -->
                        <div class="absolute inset-0 bg-gradient-to-br from-amber-100/30 to-amber-100/10 rounded-2xl -m-0.5"></div>
                        <div class="relative bg-slate-950/80 p-6 md:p-8 rounded-2xl border border-amber-100/20 shadow-xl">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                                <h2 class="text-xl font-heading text-Or-clair">Historique de paiement</h2>
                            <div class=" text- text-xs px-4 py-2 rounded-lg flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full"></span>
                                Solde actuel : <span class="text-Or-clair font-bold font-heading text-sm">128 Verbomnes</span>
                            </div>
                        </div>
                        
                        <div class="overflow-x-auto rounded-lg border border-neutral-800">
                            <table class="w-full text-sm text-left font-body">
                                <thead class="text-xs text-gray-400 bg-neutral-950 border-b border-neutral-800">
                                    <tr>
                                        <th class="px-5 py-4 font-medium">Date</th>
                                        <th class="px-5 py-4 font-medium">Description</th>
                                        <th class="px-5 py-4 font-medium">Montant</th>
                                        <th class="px-5 py-4 font-medium text-center">Statut</th>
                                    </tr>
                                </thead>
                            </table>
                        </div>
                        </div>
                    </section>

                </div>
            </div>
        </div>
    </div>
</Layout>