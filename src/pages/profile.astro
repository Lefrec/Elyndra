---
import Layout from "../layout/Layout.astro";
import PocketBase from "pocketbase";

// Le middleware protège la route et nous fournit Astro.locals.user
const user = Astro.locals.user || {};

let historiquesCommandes = [];
try {
    const POCKETBASE_URL = import.meta.env.POCKETBASE_URL ?? "http://127.0.0.1:8090";
    const pb = new PocketBase(POCKETBASE_URL);
    
    // Si la collection "achats" ou "commandes" est créée un jour, la logique est prête :
    if (user?.id) {
        // const token = Astro.cookies.get("elyndra_session")?.value;
        // if (token) pb.authStore.save(token, null);
        // historiquesCommandes = await pb.collection("commandes").getFullList({ filter: `user = "${user.id}"`, sort: "-created" });
    }
} catch (err) {
    console.error("Erreur lors de la récupération des commandes :", err);
}
---

<Layout title="Mon Profil - Elyndra">
    <div class="min-h-screen bg-[#020617] text-white py-12 px-4 sm:px-6 lg:px-8">
        <div class="max-w-5xl mx-auto space-y-8">
            
            <!-- En-tête -->
            <div>
                <h1 class="text-3xl font-bold font-heading text-Or-clair tracking-wider uppercase">Mon Profil</h1>
                <p class="mt-2 text-sm text-gray-400 font-body">Gérez vos informations personnelles, votre sécurité et vos achats.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                
                <!-- Menu latéral -->
                <div class="col-span-1 space-y-2 font-body">
                    <a href="#general" class="block px-4 py-3 rounded-lg bg-neutral-900 border-l-4 border-Or-clair text-Or-clair font-medium transition-colors">
                        Informations générales
                    </a>
                    <a href="#security" class="block px-4 py-3 rounded-lg hover:bg-neutral-900 text-gray-400 hover:text-Or-clair transition-colors">
                        Sécurité
                    </a>
                    <a href="#billing" class="block px-4 py-3 rounded-lg hover:bg-neutral-900 text-gray-400 hover:text-Or-clair transition-colors">
                        Historique de paiement
                    </a>
                    
                    <div class="pt-6 border-t border-neutral-800 mt-4">
                        <!-- Remplacez le header de l'action vers votre véritable point de terminaison de déconnexion -->
                        <form action="/api/auth/logout" method="POST">
                            <button type="submit" class="w-full text-left px-4 py-3 rounded-lg hover:bg-red-950/50 text-white hover:text-red-400 transition-colors flex items-center gap-2">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                                </svg>
                                Se déconnecter
                            </button>
                        </form>
                    </div>
                </div>

                <!-- Section de Contenu -->
                <div class="col-span-1 md:col-span-3 space-y-10">
                    
                    <!-- Formulaire : Informations Générales -->
                    <section id="general" class="relative group">
                        <!-- Fond gradient style Cards -->
                        <div class="absolute inset-0 bg-gradient-to-br from-amber-100/30 to-amber-100/10 rounded-2xl -m-0.5"></div>
                        <div class="relative bg-slate-950/80 p-6 md:p-8 rounded-2xl border border-amber-100/20 shadow-xl">
                            <h2 class="text-xl font-heading text-Or-clair mb-6">Informations Générales</h2>
                            
                            <form class="space-y-5 font-body">
                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                                <div>
                                    <label for="username" class="block text-sm font-medium text-gray-300 mb-1.5">Pseudonyme</label>
                                    <input type="text" id="username" name="username" value={user.username || ''} 
                                        class="w-full px-4 py-2.5 bg-neutral-950 border border-neutral-700 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 text-white outline-none transition-shadow" placeholder="Votre pseudo" />
                                </div>
                                <div>
                                    <label for="email" class="block text-sm font-medium text-gray-300 mb-1.5">Adresse Email</label>
                                    <input type="email" id="email" name="email" value={user.email || ''} 
                                        class="w-full px-4 py-2.5 bg-neutral-950 border border-neutral-700 rounded-lg focus:ring-2 focus:ring-elyndra-3 focus:border-elyndra-3 text-white outline-none transition-shadow" placeholder="exemple@email.com" />
                                </div>
                            </div>
                            
                            <div class="pt-4 flex justify-end">
                                <button type="button" class="px-6 py-2.5 bg-elyndra-3 hover:opacity-90 text-white rounded-[10px] transition-opacity font-semibold text-sm">
                                    Sauvegarder les modifications
                                </button>
                            </div>
                        </form>
                        </div>
                    </section>

                    <!-- Formulaire : Sécurité -->
                    <section id="security" class="relative group">
                        <!-- Fond gradient style Cards -->
                        <div class="absolute inset-0 bg-gradient-to-br from-amber-100/30 to-amber-100/10 rounded-2xl -m-0.5"></div>
                        <div class="relative bg-slate-950/80 p-6 md:p-8 rounded-2xl border border-amber-100/20 shadow-xl">
                            <h2 class="text-xl font-heading text-Or-clair mb-6">Sécurité</h2>
                            
                            <form class="space-y-5 font-body max-w-md">
                            <div>
                                <label for="current_password" class="block text-sm font-medium text-gray-300 mb-1.5">Mot de passe actuel</label>
                                <input type="password" id="current_password" name="current_password" 
                                    class="w-full px-4 py-2.5 bg-neutral-950 border border-neutral-700 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 text-white outline-none transition-shadow" placeholder="••••••••" />
                            </div>
                            <div>
                                <label for="new_password" class="block text-sm font-medium text-gray-300 mb-1.5">Nouveau mot de passe</label>
                                <input type="password" id="new_password" name="new_password" 
                                    class="w-full px-4 py-2.5 bg-neutral-950 border border-neutral-700 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 text-white outline-none transition-shadow" placeholder="••••••••" />
                            </div>
                            <div>
                                <label for="confirm_password" class="block text-sm font-medium text-gray-300 mb-1.5">Confirmer le nouveau mot de passe</label>
                                <input type="password" id="confirm_password" name="confirm_password" 
                                    class="w-full px-4 py-2.5 bg-neutral-950 border border-neutral-700 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 text-white outline-none transition-shadow" placeholder="••••••••" />
                            </div>
                            
                            <div class="pt-4">
                                <button type="button" class="px-6 py-2.5 bg-elyndra-3 hover:opacity-90 text-white rounded-[10px] transition-opacity font-semibold text-sm shadow-[0_0_15px_rgba(217,119,66,0.3)]">
                                    Mettre à jour le mot de passe
                                </button>
                            </div>
                        </form>
                        </div>
                    </section>

                    <!-- Historique de paiement -->
                    <section id="billing" class="relative group">
                        <!-- Fond gradient style Cards -->
                        <div class="absolute inset-0 bg-gradient-to-br from-amber-100/30 to-amber-100/10 rounded-2xl -m-0.5"></div>
                        <div class="relative bg-slate-950/80 p-6 md:p-8 rounded-2xl border border-amber-100/20 shadow-xl">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                                <h2 class="text-xl font-heading text-Or-clair">Historique de paiement</h2>
                            <div class=" text- text-xs px-4 py-2 rounded-lg flex items-center gap-2">
                                <span class="w-2 h-2 rounded-full"></span>
                                Solde actuel : <span class="text-Or-clair font-bold font-heading text-sm">128 Verbomnes</span>
                            </div>
                        </div>
                        
                        <div class="overflow-x-auto rounded-lg border border-neutral-800">
                            <table class="w-full text-sm text-left font-body">
                                <thead class="text-xs text-gray-400 bg-neutral-950 border-b border-neutral-800">
                                    <tr>
                                        <th class="px-5 py-4 font-medium">Date</th>
                                        <th class="px-5 py-4 font-medium">Description</th>
                                        <th class="px-5 py-4 font-medium">Montant</th>
                                        <th class="px-5 py-4 font-medium text-center">Statut</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-neutral-800 bg-neutral-900/30">
                                    {historiquesCommandes.length > 0 ? (
                                        historiquesCommandes.map((commande) => (
                                            <tr class="hover:bg-neutral-800/50 transition-colors">
                                                <td class="px-5 py-4 text-gray-300">
                                                    {new Date(commande.created).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short', year: 'numeric' })}
                                                </td>
                                                <td class="px-5 py-4 text-gray-200">{commande.description}</td>
                                                <td class="px-5 py-4 text-white font-medium">{commande.montant} €</td>
                                                <td class="px-5 py-4 text-center">
                                                    <span class="inline-block bg-green-950/50 text-green-400 text-xs px-2.5 py-1 rounded-full border border-green-900/50">
                                                        {commande.statut}
                                                    </span>
                                                </td>
                                            </tr>
                                        ))
                                    ) : (
                                        <tr>
                                            <td colspan="4" class="px-5 py-10 text-center">
                                                <div class="flex flex-col items-center justify-center gap-2">
                                                    <span class="text-base font-medium text-gray-300">Aucun achat</span>
                                                    <span class="text-sm text-gray-500 font-body">Vous n'avez pas encore effectué de commande pour votre aventure.</span>
                                                </div>
                                            </td>
                                        </tr>
                                    )}
                                </tbody>
                            </table>
                        </div>
                        </div>
                    </section>

                </div>
            </div>
        </div>
    </div>
</Layout>