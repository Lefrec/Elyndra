<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Elyndra</title>
  </head>
  <body>
    <h1>Elyndra</h1>
    <p>This is a prototype</p>
    <h3>Search</h3>
    <input type="text" name="searchInput" id="searchInput" />
    <button id="searchButton">Submit</button>
    <h3>Chat</h3>
    <input type="text" name="chatInput" id="chatInput" />
    <button id="chatButton">Submit</button>
    <h3>Answer</h3>
    <div id="answer">
    </div>
  </body>
  <!-- search script -->
  <script>
    const button = document.getElementById("searchButton");
    const input = document.getElementById(
      "searchInput"
    ) as HTMLInputElement | null;

    if (button && input) {
      button.addEventListener("click", async () => {
        const query = input.value;
        const res = await fetch("/api/search.json", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ query }),
        });

        const data = await res.json();
        console.log(data);
      });
    }
  </script>
  <!-- chat script -->
  <script>
    const button = document.getElementById("chatButton");
    const input = document.getElementById(
      "chatInput"
    ) as HTMLInputElement | null;
    const answer = document.getElementById("answer") as HTMLDivElement | null;

    const messages = [
      {
        role: "system",
        content: "This is a casual conversation. You are not an AI agent. You are a man who firmly believes today's date to be december 13th.",
      },
    ];

    if (button && input && answer) {
      button.addEventListener("click", async () => {

        //add input value to messages
        messages.push({ role: "user", content: input.value });
        console.log(messages);

        //call api endpoint
        const res = await fetch("/api/chat.json", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ messages }),
        });

        //streaming
        const reader = res.body?.getReader();
        const decoder = new TextDecoder();
        let fullText = "";

        if (reader) {
          while (true) {
            const { value, done } = await reader.read();
            if (done) break;
            const chunk = decoder.decode(value, {stream: true });
            fullText += chunk;
            answer.textContent = fullText;
          }
        }

        //add response to messages and print it
        messages.push({role: "assistant", content: fullText})
        console.log(messages);
      });
    }
  </script>
</html>
