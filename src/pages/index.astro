---
import Layout from "../layout/Layout.astro";
import heroImage from "../assets/hero_landing.webp";
import Cards from "../components/Cards.astro";
---

<Layout>
    <!-- Hero -->
    <section class="hero flex items-center justify-center">
        <div class="w-full relative">
            <!-- Image de fond -->
            <img
                src={heroImage.src}
                alt="Hero background"
                class="absolute inset-0 w-full h-full object-cover rounded-2xl"
            />

            <!-- Contenu -->
            <div
                class="relative py-16 px-8 flex flex-col items-center text-center gap-8"
            >
                <!-- Titre principal -->
                <h1
                    class="text-7xl font-bold tracking-widest text-elyndra-gradient"
                >
                    ELYNDRA
                </h1>

                <!-- Description -->
                <p class="text-lg max-w-2xl leading-relaxed">
                    Le Gardien est devenu le Destructeur. Vorathys a sombré, et
                    avec lui, tout Élyndra. Quelle ombre a pu consumer un dieu
                    au point de lui faire détruire ce qu'il jurait de protéger ?
                    Le temps presse : trouvez la vérité avant que le monde ne
                    s'éteigne pour toujours.
                </p>

                <!-- Statistiques -->
                <div
                    class="flex gap-16 px-12 py-6 rounded-full border border-slate-700 relative bg-[#270447]/22"
                >
                    <div class="flex items-center gap-3">
                        <svg
                            class="w-8 h-8"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <rect x="3" y="3" width="7" height="7" rx="1"
                            ></rect>
                            <rect x="14" y="3" width="7" height="7" rx="1"
                            ></rect>
                            <rect x="3" y="14" width="7" height="7" rx="1"
                            ></rect>
                            <rect x="14" y="14" width="7" height="7" rx="1"
                            ></rect>
                        </svg>
                        <div class="text-left">
                            <div class="text-2xl font-bold">4</div>
                            <div class="text-sm text-gray-300">Biomes</div>
                        </div>
                    </div>

                    <div class="flex items-center gap-3">
                        <svg
                            class="w-8 h-8"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"
                            ></path>
                        </svg>
                        <div class="text-left">
                            <div class="text-2xl font-bold">100+</div>
                            <div class="text-sm text-gray-300">Quêtes</div>
                        </div>
                    </div>

                    <div class="flex items-center gap-3">
                        <svg
                            class="w-8 h-8"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                d="M17 12C17 14.7614 14.7614 17 12 17C9.23858 17 7 14.7614 7 12C7 9.23858 9.23858 7 12 7C14.7614 7 17 9.23858 17 12Z"
                            ></path>
                            <path d="M12 2V7M12 17V22M2 12H7M17 12H22"></path>
                        </svg>
                        <div class="text-left">
                            <div class="text-2xl font-bold">∞</div>
                            <div class="text-sm text-gray-300">
                                Possibilités
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Boutons -->
                <div class="flex gap-6 mt-4">
                    <button
                        class="px-4 py-3.5 bg-elyndra-3 rounded-[10px] inline-flex justify-center items-center gap-3 overflow-hidden"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path d="M8 5v14l11-7z"></path>
                        </svg>
                        Commencer à jouer
                    </button>
                    <button
                        class="bg-gradient-to-t from-neutral-400 to-white rounded-[10px] hover:bg-gray-300 text-gray-900 px-8 py-3"
                    >
                        Comprendre le jeu
                    </button>
                </div>
            </div>
        </div>
    </section>

    <!-- Explication du jeu -->
    <section class="py-16 px-8">
        <div class="max-w-7xl mx-auto">
            <!-- Titre avec décoration -->
            <div class="flex flex-col items-center gap-5 mb-16">
                <!-- Ligne décorative supérieure -->
                <div class="flex items-center gap-3.5">
                    <div class="w-52 h-px bg-gradient-to-r from-transparent to-amber-200"></div>
                    <div class="w-3.5 h-2 rotate-45 bg-amber-200"></div>
                    <div class="w-1 h-1 bg-amber-200 rounded-full"></div>
                    <div class="w-3.5 h-2 rotate-45 bg-amber-200"></div>
                    <div class="w-52 h-px bg-gradient-to-l from-transparent to-amber-200"></div>
                </div>

                <!-- Titre principal -->
                <h2 class="text-3xl font-heading text-amber-200 tracking-[6px] text-center shadow-[0px_0px_30px_0px_rgba(178,158,94,0.50)]">
                    COMMENT SE PASSE VOTRE VOYAGE ?
                </h2>

                <!-- Ligne décorative inférieure -->
                <div class="flex items-center gap-3.5">
                    <div class="w-24 h-px bg-gradient-to-r from-transparent to-amber-200"></div>
                    <div class="w-3.5 h-2 rotate-45 bg-amber-200"></div>
                    <div class="w-1 h-1 bg-amber-200 rounded-full"></div>
                    <div class="w-3.5 h-2 rotate-45 bg-amber-200"></div>
                    <div class="w-24 h-px bg-gradient-to-l from-transparent to-amber-200"></div>
                </div>
            </div>

            <!-- Cartes d'étapes -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <Cards 
                    number="01" 
                    title="Choisissez Votre Biome"
                    text="Sélectionnez le monde dans lequel vous souhaitez débuter votre aventure."
                />
                <Cards 
                    number="02" 
                    title="Créez Votre Héros"
                    text="Choisissez votre type de personnage et donnez-lui un nom légendaire."
                />
                <Cards 
                    number="03" 
                    title="Partez à l'Aventure"
                    text="Explorez le monde, combattez des ennemis, accomplissez des quêtes et devenez la légende que vous êtes destiné à être."
                />
            </div>
        </div>
    </section>
</Layout>
