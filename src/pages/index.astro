---
import Layout from "../layout/Layout.astro";
import heroImage from "../assets/hero_landing.webp";
import Cards from "../components/Cards.astro";
import CardsCharacter from "../components/Cards_character.astro";
import chevalierImage from "../assets/chevalier.webp";
import mageImage from "../assets/mage.webp";
import alchimisteImage from "../assets/alchimiste.webp";
import ombreImage from "../assets/ombre.webp";

const isLoggedIn = !!Astro.cookies.get("elyndra_session")?.value;
---

<Layout showBanner={!isLoggedIn}>
    <!-- BANDEAU FLOTTANT  -->
    {!isLoggedIn && (
        <div id="promo-banner" class="fixed top-0 left-0 right-0 z-[60] flex items-center justify-center gap-4 px-4 py-3 bg-gradient-to-r from-[#110224] via-[#2d0f4e] to-[#110224] border-b border-Or-clair/30 shadow-lg shadow-black/40">
            <span class="text-Or-clair text-sm md:text-base font-medium tracking-wide">
                🎁 Inscris-toi maintenant et reçois <strong>100 crédits de bienvenue</strong>
            </span>
            <a
                href="/login"
                class="shrink-0 px-4 py-1.5 bg-[#612D53] rounded-[8px] text-sm font-semibold hover:opacity-90 transition-opacity whitespace-nowrap"
            >
                S'inscrire
            </a>
            <button
                id="close-banner"
                aria-label="Fermer le bandeau"
                class="absolute right-4 text-Or-clair/60 hover:text-Or-clair transition-colors text-lg leading-none"
            >
                ✕
            </button>
        </div>
        <div id="promo-spacer" class="h-[52px]"></div>
    )}

    <!-- Hero -->
    <section class="hero flex items-center justify-center">
        <div class="w-full relative">
            <!-- Image de fond -->
            <img
                src={heroImage.src}
                alt="Hero background"
                class="absolute inset-0 w-full h-full object-cover rounded-2xl"
            />

            <!-- Contenu -->
            <div
                class="relative py-16 md:py-20 px-8 flex flex-col items-center text-center gap-8"
            >
                <!-- Titre principal -->
                <h1
                    class="text-5xl md:text-7xl font-bold tracking-widest text-elyndra-gradient"
                >
                    ELYNDRA
                </h1>

                <!-- Description -->
                <p class="text-base md:text-lg max-w-2xl leading-relaxed">
                    Le Gardien est devenu le Destructeur. Vorathys a sombré, et
                    avec lui, tout Élyndra. Quelle ombre a pu consumer un dieu
                    au point de lui faire détruire ce qu'il jurait de protéger ?
                    Le temps presse : trouvez la vérité avant que le monde ne
                    s'éteigne pour toujours.
                </p>
                    <!-- Incentives inscription -->
                 <span class="text-Or-clair/80 tracking-wide text-center mt-2 font-bold">Le gardien t'invite dans des mondes infinis...</span>
                <div class="flex flex-wrap justify-center gap-x-8 gap-y-2 mt-2">
                    <span class="text-sm text-Or-clair/80 tracking-wide"> 200 aventures dès ton premier voyage !</span>
                    <span class="text-sm text-Or-clair/80 tracking-wide"> + 100 crédits gratuits chaque jour</span>
                    <span class="text-sm text-Or-clair/80 tracking-wide"> + 150 crédits par ami invité</span>
                </div>
                <span class="text-Or-clair/80 tracking-wide text-center mt-2 font-bold">Le guide IA est à tes côtés pour créer ton histoire unique.</span>
                <!-- Boutons -->
                <div class="flex flex-col sm:flex-row gap-4 sm:gap-6 w-full sm:w-auto mt-4 px-4 sm:px-0">
                    <a
                        href="/choixbiome"
                        class="px-4 py-3.5 bg-elyndra-3 rounded-[10px] sm:inline-flex flex justify-center items-center gap-3 overflow-hidden hover:opacity-90 w-full sm:w-auto"
                    >
                        <svg
                            class="w-5 h-5"
                            fill="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path d="M8 5v14l11-7z"></path>
                        </svg>
                        Commencer à jouer
                    </a>
                    <a
                        href="#explication"
                        class="bg-gradient-to-t from-neutral-400 to-white rounded-[10px] hover:bg-gray-300 text-Texte-bleu-fonce px-8 py-3 hover:opacity-90 flex sm:inline-flex items-center justify-center gap-3 overflow-hidden w-full sm:w-auto"
                    >
                        Comprendre le jeu
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Explication du jeu -->
    <section id="explication">
        <div class="max-w-7xl mx-auto px-4 md:px-8">
            <!-- Titre avec décoration -->
            <div class="flex flex-col items-center gap-10 mb-16 px-4">
                <!-- Ligne décorative supérieure -->
                <svg
                    viewBox="0 0 1440 26"
                    class="w-full max-w-[1440px] h-auto"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                    ><path
                        transform="translate(-6.142 11.728)"
                        fill="url(#a)"
                        d="M0 0H670V2H0z"></path><path
                        transform="rotate(45 345.464 834.025)"
                        fill="#FFE9B5"
                        d="M0 0H18V18H0z"></path><path
                        d="M718 12.728a2 2 0 114 0 2 2 0 01-4 0z"
                        fill="#EED9A9"></path><path
                        transform="rotate(45 374.536 904.209)"
                        fill="#FFE9B5"
                        d="M0 0H18V18H0z"></path><path
                        transform="translate(776.142 11.728)"
                        fill="url(#b)"
                        d="M0 0H670V2H0z"></path><defs
                        ><linearGradient
                            id="a"
                            x1="670"
                            y1="1"
                            x2="0"
                            y2="1"
                            gradientUnits="userSpaceOnUse"
                            ><stop stop-color="#D9C69A"></stop><stop
                                offset="1"
                                stop-opacity="0"></stop></linearGradient
                        ><linearGradient
                            id="b"
                            x1="670"
                            y1="1"
                            x2="0"
                            y2="1"
                            gradientUnits="userSpaceOnUse"
                            ><stop stop-opacity="0"></stop><stop
                                offset="1"
                                stop-color="#D9C69A"></stop></linearGradient
                        ></defs
                    ></svg
                >
                <!-- Titre principal -->
                <h2
                    class="text-3xl font-heading text-Or-clair tracking-[6px] text-center"
                >
                    COMMENT SE PASSE VOTRE VOYAGE ?
                </h2>
            </div>

            <!-- Cartes d'étapes -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <Cards
                    compact
                    number="01"
                    title="Choisissez Votre Biome"
                    text="Sélectionnez le monde dans lequel vous souhaitez débuter votre aventure."
                />
                <Cards
                    compact
                    number="02"
                    title="Créez Votre Héros"
                    text="Choisissez votre type de personnage et donnez-lui un nom légendaire."
                />
                <Cards
                    compact
                    number="03"
                    title="Partez à l'Aventure"
                    text="Explorez le monde, combattez des ennemis, accomplissez des quêtes et devenez la légende que vous êtes destiné à être."
                />
            </div>
        </div>
    </section>

    <section class="py-16">
        <!-- Ligne décorative supérieure -->
        <svg
            viewBox="0 0 1440 26"
            class="w-full max-w-[1440px] h-auto px-4"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            ><path
                transform="translate(-6.142 11.728)"
                fill="url(#a)"
                d="M0 0H670V2H0z"></path><path
                transform="rotate(45 345.464 834.025)"
                fill="#FFE9B5"
                d="M0 0H18V18H0z"></path><path
                d="M718 12.728a2 2 0 114 0 2 2 0 01-4 0z"
                fill="#EED9A9"></path><path
                transform="rotate(45 374.536 904.209)"
                fill="#FFE9B5"
                d="M0 0H18V18H0z"></path><path
                transform="translate(776.142 11.728)"
                fill="url(#b)"
                d="M0 0H670V2H0z"></path><defs
                ><linearGradient
                    id="a"
                    x1="670"
                    y1="1"
                    x2="0"
                    y2="1"
                    gradientUnits="userSpaceOnUse"
                    ><stop stop-color="#D9C69A"></stop><stop
                        offset="1"
                        stop-opacity="0"></stop></linearGradient
                ><linearGradient
                    id="b"
                    x1="670"
                    y1="1"
                    x2="0"
                    y2="1"
                    gradientUnits="userSpaceOnUse"
                    ><stop stop-opacity="0"></stop><stop
                        offset="1"
                        stop-color="#D9C69A"></stop></linearGradient
                ></defs
            ></svg
        >
        <h3
            class="text-3xl font-heading text-Or-clair tracking-[5px] text-center my-16"
        >
            Qui seriez-vous ?
        </h3>

        <div class="max-w-7xl mx-auto px-4">
            <div
                class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8 items-end justify-items-center"
            >
                <!-- Ombre -->
                <div class="w-full flex justify-center relative group min-h-[300px]" onclick="this.classList.toggle('clicked')">
                    <img
                        src={ombreImage.src}
                        alt="Ombre"
                        class="w-full max-w-[16rem] h-auto object-contain transition-all duration-500 group-hover:opacity-0 group-hover:scale-90 group-[.clicked]:opacity-0 group-[.clicked]:scale-90"
                    />
                    <div class="absolute inset-0 flex flex-col justify-center bg-slate-950/80 backdrop-blur-md border border-Or-clair/20 rounded-2xl p-6 opacity-0 group-hover:opacity-100 transition-all duration-500 scale-95 group-hover:scale-100 group-[.clicked]:opacity-100 group-[.clicked]:scale-100 text-center z-10 w-full max-w-[18rem] mx-auto h-full sm:h-[90%] my-auto">
                        <h4 class="text-xl font-heading text-Or-clair mb-3 tracking-widest uppercase">L'Ombre</h4>
                        <p class="text-sm text-gray-300 leading-relaxed">Si vous préférez contourner les dangers avec finesse et frapper vos cibles sans jamais laisser la moindre trace, l'Ombre sera votre meilleure alliée.</p>
                    </div>
                </div>

                <!-- Mage -->
                <div class="w-full flex justify-center relative group min-h-[300px]" onclick="this.classList.toggle('clicked')">
                    <img
                        src={mageImage.src}
                        alt="Mage"
                        class="w-full max-w-[20rem] h-auto object-contain transition-all duration-500 group-hover:opacity-0 group-hover:scale-90 group-[.clicked]:opacity-0 group-[.clicked]:scale-90"
                    />
                    <div class="absolute inset-0 flex flex-col justify-center bg-slate-950/80 backdrop-blur-md border border-Or-clair/20 rounded-2xl p-6 opacity-0 group-hover:opacity-100 transition-all duration-500 scale-95 group-hover:scale-100 group-[.clicked]:opacity-100 group-[.clicked]:scale-100 text-center z-10 w-full max-w-[18rem] mx-auto h-full sm:h-[90%] my-auto">
                        <h4 class="text-xl font-heading text-Or-clair mb-3 tracking-widest uppercase">La Mage</h4>
                        <p class="text-sm text-gray-300 leading-relaxed">Si pour vous, le savoir est la véritable arme et que manipuler la réalité vous fascine plus qu'une simple épée, la Mage est votre destinée.</p>
                    </div>
                </div>

                <!-- Chevalier -->
                <div class="w-full flex justify-center relative group min-h-[300px]" onclick="this.classList.toggle('clicked')">
                    <img
                        src={chevalierImage.src}
                        alt="Chevalier"
                        class="w-full max-w-[16rem] h-auto object-contain transition-all duration-500 group-hover:opacity-0 group-hover:scale-90 group-[.clicked]:opacity-0 group-[.clicked]:scale-90"
                    />
                    <div class="absolute inset-0 flex flex-col justify-center bg-slate-950/80 backdrop-blur-md border border-Or-clair/20 rounded-2xl p-6 opacity-0 group-hover:opacity-100 transition-all duration-500 scale-95 group-hover:scale-100 group-[.clicked]:opacity-100 group-[.clicked]:scale-100 text-center z-10 w-full max-w-[18rem] mx-auto h-full sm:h-[90%] my-auto">
                        <h4 class="text-xl font-heading text-Or-clair mb-3 tracking-widest uppercase">Le Chevalier</h4>
                        <p class="text-sm text-gray-300 leading-relaxed">Si vous préférez charger en première ligne et protéger vos alliés plutôt que de vous cacher dans l'ombre, choisissez la voie du Chevalier.</p>
                    </div>
                </div>

                <!-- Alchimiste -->
                <div class="w-full flex justify-center relative group min-h-[300px]" onclick="this.classList.toggle('clicked')">
                    <img
                        src={alchimisteImage.src}
                        alt="Alchimiste"
                        class="w-full max-w-[15rem] h-auto object-contain transition-all duration-500 group-hover:opacity-0 group-hover:scale-90 group-[.clicked]:opacity-0 group-[.clicked]:scale-90"
                    />
                    <div class="absolute inset-0 flex flex-col justify-center bg-slate-950/80 backdrop-blur-md border border-Or-clair/20 rounded-2xl p-6 opacity-0 group-hover:opacity-100 transition-all duration-500 scale-95 group-hover:scale-100 group-[.clicked]:opacity-100 group-[.clicked]:scale-100 text-center z-10 w-full max-w-[18rem] mx-auto h-full sm:h-[90%] my-auto">
                        <h4 class="text-xl font-heading text-Or-clair mb-3 tracking-widest uppercase">L'Alchimiste</h4>
                        <p class="text-sm text-gray-300 leading-relaxed">Si vous êtes du genre à toujours avoir le bon outil pour la bonne situation et à expérimenter avec l'inconnu, l'Alchimiste sera votre meilleur atout.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section>
        <!-- Ligne décorative inférieure -->
        <svg
            viewBox="0 0 1440 26"
            class="w-full max-w-[1440px] h-auto px-4"
            fill="none"
            xmlns="http://www.w3.org/2000/svg"
            ><path
                transform="translate(-6.142 11.728)"
                fill="url(#a)"
                d="M0 0H670V2H0z"></path><path
                transform="rotate(45 345.464 834.025)"
                fill="#FFE9B5"
                d="M0 0H18V18H0z"></path><path
                d="M718 12.728a2 2 0 114 0 2 2 0 01-4 0z"
                fill="#EED9A9"></path><path
                transform="rotate(45 374.536 904.209)"
                fill="#FFE9B5"
                d="M0 0H18V18H0z"></path><path
                transform="translate(776.142 11.728)"
                fill="url(#b)"
                d="M0 0H670V2H0z"></path><defs
                ><linearGradient
                    id="a"
                    x1="670"
                    y1="1"
                    x2="0"
                    y2="1"
                    gradientUnits="userSpaceOnUse"
                    ><stop stop-color="#D9C69A"></stop><stop
                        offset="1"
                        stop-opacity="0"></stop></linearGradient
                ><linearGradient
                    id="b"
                    x1="670"
                    y1="1"
                    x2="0"
                    y2="1"
                    gradientUnits="userSpaceOnUse"
                    ><stop stop-opacity="0"></stop><stop
                        offset="1"
                        stop-color="#D9C69A"></stop></linearGradient
                ></defs
            ></svg
        >
        <h3
            class="text-3xl text-Or-clair tracking-[5px] text-center my-16"
        >
            L'Art du Jeu Nararatif
        </h3>

        <div class="max-w-7xl mx-auto px-8">
            <div
                class="grid grid-cols-1 md:grid-cols-[0.70fr_1.30fr] gap-8 mb-12"
            >
                <Cards
                    number="01"
                    title="Explorez les Biomes"
                    text="Chaque biome possède ses propres défis, ennemis et trésors à découvrir. Naviguez à travers des environnements uniques et mystérieux."
                />
                <Cards
                    number="02"
                    title="Accomplissez des Quêtes Épiques"
                    text="Obtenez des équipements variés (armes, armures, artefacts) en explorant les recoins sombres que l'IA génère pour vous. Chaque combat remporté, chaque coffre découvert enrichit votre arsenal. Votre puissance dépend de votre préparation : utilisez les ressources récupérées pour améliorer les statistiques de votre matériel et créer l'équipement ultime adapté à votre style de jeu."
                />
            </div>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-12">
                <Cards
                    number="03"
                    title="Compétences & Évolution"
                    text="Définissez vos attributs, de la force brute à l'intelligence arcanique. Vos compétences influencent directement la réussite de vos actions. Gagnez en expérience pour débloquer de nouveaux talents et transformer votre novice en maître redouté. Ainsi, chaque décision façonne votre héros et son destin."
                />
                <Cards
                    number="04"
                    title="Combat"
                    text="Pas de clics, mais des mots. Décrivez vos tactiques avec précision : jetez du sable, renversez un brasero, visez les failles. L'IA juge l'issue du duel selon votre équipement, vos stats et votre ingéniosité tactique. Chaque combat est unique, évoluant en fonction de vos choix stratégiques. Sois donc créatif et audacieux !"
                />
                <Cards
                    number="05"
                    title="Dialoguer avec l'IA"
                    text="Oubliez les actions préconçues. Décrivez vos intentions en toute liberté : négocier, briser, s'infiltrer... L'IA analyse votre audace et tisse la suite de l'histoire en temps réel, réagissant à chaque nuance de vos paroles. Chaque interaction est une occasion de créer ta propre légende qui répond à ton imagination. Alors exprime toi pleinement !"
                />
            </div>
            <div class="grid grid-cols-1 gap-8 mb-5">
                <Cards
                    number="06"
                    title="Décisions & Conséquences"
                    text="Une épopée principale vous offrira un but clair, une lumière à suivre dans les ténèbres, mais ne vous y trompez pas : la véritable richesse de ce monde ne révélera ses secrets que si vous osez le provoquer. Ne soyez pas un simple spectateur. Interrogez un garde au comportement suspicieux, déchiffrez les runes d'un livre poussiéreux oublié dans une crypte, ou décidez de suivre une piste subtile que vous seul avez remarquée. C'est en prenant ces initiatives audacieuses que la magie opère : l'IA réagira à votre curiosité en tissant instantanément des quêtes secondaires complexes et des mystères profonds. Votre aventure ne sera pas simplement une histoire que l'on vous raconte, mais une destinée unique, taillée sur mesure par vos propres choix."
                />
            </div>
        </div>
        <div class="flex justify-center py-16">
            <div class="text-center space-y-6">
                <h4
                    class="text-2xl font-heading text-Or-clair tracking-[3px]"
                >
                    Prêt à Écrire Votre Légende ?
                </h4>
                <a
                    href="/choixbiome"
                    class="px-10 py-5 bg-elyndra-3 rounded-[10px] inline-flex justify-center items-center gap-4 overflow-hidden hover:scale-105 transition-transform text-lg"
                >
                    <svg
                        class="w-6 h-6"
                        fill="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path d="M8 5v14l11-7z"></path>
                    </svg>
                    Commencer Votre Aventure
                </a>
                <p class="text-sm text-gray-400 max-w-md mx-auto">
                    Rejoignez des milliers d'aventuriers dans un monde où chaque
                    choix compte
                </p>
            </div>
        </div>
    </section>
</Layout>

<script>
    const banner  = document.getElementById('promo-banner');
    const spacer  = document.getElementById('promo-spacer');
    const closeBtn = document.getElementById('close-banner');

    closeBtn?.addEventListener('click', () => {
        banner?.remove();
        spacer?.remove();
        const header = document.getElementById('site-header');
        if (header) {
            header.classList.remove('top-[52px]');
            header.classList.add('top-0');
        }
    });
</script>