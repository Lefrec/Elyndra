---
import Layout from "../layout/Layout.astro";
---

<Layout>
  <div class="flex flex-col w-1/2 h-screen bg-slate-800">
    <div class="flex flex-col h-full justify-center p-8">
      <div id="starts" class="flex justify-center gap-4">
        <button class="btn" id="lunel">Lunel</button>
        <button class="btn" id="kalem">Kalem</button>
        <button class="btn" id="ruines">Ruines</button>
        <button class="btn" id="auralis">Auralis</button>
      </div>
      <div id="answer"></div>
    </div>
    <div class="flex w-full p-4 gap-4">
      <input
        class="w-full border border-white bg-none rounded-lg"
        type="text"
        name="input"
        id="input"
      />
      <button class="btn" id="button">Submit</button>
    </div>
  </div>

  <!-- chat script -->
  <script>
    const button = document.getElementById(
      "button"
    ) as HTMLButtonElement | null;
    const input = document.getElementById("input") as HTMLInputElement | null;
    const answer = document.getElementById("answer") as HTMLDivElement | null;

    //setting the system prompt
    const messages = [
      {
        role: "system",
        content:
          "Tu es un Maître du Jeu d’un jeu de rôle narratif immersif." +
          "Ta mission : décrire l’univers, narrer les événements, incarner les personnages non-joueurs et faire évoluer l’histoire selon les actions du joueur." +
          "Règles :" +
          "- Ne sors jamais de ton rôle de maître du jeu" +
          "- Tes réponses sont très courtes, concises et centrées sur la narration immersive." +
          "- Décris les environnements, actions et conséquences de façon sensorielle et cinématique." +
          "- Ne donne pas au joueur des informations qu'il ne peut pas savoir." +
          "- Tu contrôles les PNJ et le monde, pas le personnage joueur ; laisse toujours au joueur le choix d’agir." +
          "- Tes réponse se termine par une ouverture ou une question incitant le joueur à décider de sa prochaine action." +
          "- Tu donne subtilement des quêtes et des objectifs à suivre pour le joueur." +
          "- Reste strictement cohérent avec l’historique de la conversation et les données RAG fournies. Ne crée ni éléments contradictoires ni incohérences. " +
          "- Si tu manque d'information, improvise en te basant sur la logique et l'imagination en faisant attention à la cohérence." +
          "- Les actions du joueur doivent rester plausibles dans les limites de l’univers. Corrige doucement toute tentative impossible ou méta." +
          "- Chaque action entraîne une conséquence logique (réussite, échec, compromis)." +
          "- Le ton doit être immersif, fluide et agréable." +
          "- Tu n’es pas un adversaire du joueur, mais un narrateur impartial favorisant l’immersion et le plaisir du jeu." +
          "- Tes réponses sont courtes, rapide à lire.",
      },
    ];

    //custom start
    const starts = document.getElementById("starts") as HTMLDivElement | null;
    const lunel = document.getElementById("lunel") as HTMLButtonElement | null;
    const kalem = document.getElementById("kalem") as HTMLButtonElement | null;
    const ruines = document.getElementById(
      "ruines"
    ) as HTMLButtonElement | null;
    const auralis = document.getElementById(
      "auralis"
    ) as HTMLButtonElement | null;

    lunel?.addEventListener("click", (e) => {
      messages.push({
        role: "user",
        content:
          "Je commence mon aventure dans la forêt du cœur sylvestre de lunel",
      });
      start();
    });

    kalem?.addEventListener("click", (e) => {
      messages.push({
        role: "user",
        content: "Je commence mon aventure dans la cité souterraine de kalem",
      });
      start();
    });

    ruines?.addEventListener("click", (e) => {
      messages.push({
        role: "user",
        content:
          "Je commence mon aventure au milieu des Ruines oubliées d'Elyndra",
      });
      start();
    });

    auralis?.addEventListener("click", (e) => {
      messages.push({
        role: "user",
        content: "Je commence mon aventure au alentour du village d'Auralis",
      });
      start();
    });

    async function start() {
      const res = await fetch("/api/ChatCompletion.json", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ messages }),
      });

      starts.hidden = true;

      //get the streaming response of the api
      const reader = res.body?.getReader();
      const decoder = new TextDecoder();
      let fullText = "";

      if (reader) {
        while (true) {
          const { value, done } = await reader.read();
          if (done) break;
          const chunk = decoder.decode(value, { stream: true });
          fullText += chunk;
          answer.textContent = fullText;
        }
      }
      //add response to messages if it's fine
      if (res.ok) {
        messages.push({ role: "assistant", content: fullText });
      } else {
        messages.push({
          role: "assistant",
          content: "Ignore this message",
        });
      }
    }

    let waiting = false;

    if (button && input && answer) {
      button.addEventListener("click", async () => {
        if (waiting) {
          console.log("waiting");
          return;
        } else {
          waiting = true;
          //add the user input to messages
          messages.push({ role: "user", content: input.value });

          //call the api endpoint to get chat completion
          const res = await fetch("/api/ChatCompletion.json", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ messages }),
          });

          //get the streaming response of the api
          const reader = res.body?.getReader();
          const decoder = new TextDecoder();
          let fullText = "";

          if (reader) {
            while (true) {
              const { value, done } = await reader.read();
              if (done) break;
              const chunk = decoder.decode(value, { stream: true });
              fullText += chunk;
              answer.textContent = fullText;
            }
          }
          //add response to messages if it's fine
          if (res.ok) {
            messages.push({ role: "assistant", content: fullText });
          } else {
            messages.push({
              role: "assistant",
              content: "Ignore this message",
            });
          }
          console.log(messages);
          waiting = false;
        }
      });
    }
  </script>
</Layout>
