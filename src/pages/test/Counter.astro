---
import Layout from "../../layout/Layout.astro";
---

<Layout>
  <div class="flex flex-col w-1/2 h-screen bg-slate-800">
    <div class="flex flex-col h-full justify-center p-8">
      <div id="answer"></div>
    </div>
    <div class="flex w-full p-4 gap-4">
      <input
        class="w-full border border-white bg-none rounded-lg"
        type="text"
        name="input"
        id="input"
      />
      <button class="btn" id="button">Submit</button>
    </div>
  </div>

  <!-- chat script -->
  <script>
    const button = document.getElementById(
      "button"
    ) as HTMLButtonElement | null;
    const input = document.getElementById("input") as HTMLInputElement | null;
    const answer = document.getElementById("answer") as HTMLDivElement | null;

    if (button && input && answer) {
      button.addEventListener("click", async () => {
        const userMessage = input.value.trim();
        if (!userMessage) return;

        const res = await fetch("/api/testingTools.json", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            message: userMessage, // the endpoint code reads { message }
          }),
        });

        if (!res.ok) {
          const text = await res.text();
          answer.textContent = `Error ${res.status}: ${text}`;
          return;
        }

        const data = await res.json();
        // expecting the endpoint to return { reply, counter }
        answer.textContent = data.reply;
      });
    }
  </script>
</Layout>
