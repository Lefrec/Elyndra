---
import Layout from "../layout/Layout.astro";
import heroImage from "../assets/hero_choix.webp";
import lunel from "../assets/biomes/lunel.webp";
import solarys from "../assets/biomes/solarys.webp";
import auralis from "../assets/biomes/auralis.webp";
import elyndra from "../assets/biomes/elyndra.webp";

const biomes = [
    {
        id: 1,
        title: "Le Cœur Sylvestre de Lunel",
        description: "Une jungle oppressante avec des cités perchées et des dangers au sol",
        image: lunel,
        link: "/biomes/lunel"
    },
    {
        id: 2,
        title: "Les Dunes ardentes de Solarys",
        description: "Une immensité aride avec un oasis solitaire et un monde souterrain",
        image: solarys,
        link: "/biomes/solarys"
    },
    {
        id: 3,
        title: "Le Village Gelé d'Auralis",
        description: "Un refuge givré avec des vents mordants et des spectres de glace",
        image: auralis,
        link: "/biomes/auralis"
    },
    {
        id: 4,
        title: "Les Ruines Oubliées d'Élyndra",
        description: "Une cité perdue avec des pierres runiques et des légendes oubliées",
        image: elyndra,
        link: "/biomes/elyndra"
    }
];
---

<Layout>
<!-- Hero -->
<section class="hero flex items-center justify-center min-h-[500px] md:min-h-[550px]">
    <div class="w-full relative h-full">
        <!-- Image de fond -->
        <img
            src={heroImage.src}
            alt="Hero background"
            class="absolute inset-0 w-full h-full object-cover"
        />

        <!-- Overlay assombrissement + vignette -->
        <div class="absolute inset-0 bg-slate-950/40"></div>
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(0,0,0,0)_20%,rgba(0,0,0,0.7)_80%)]"></div>

        <!-- Contenu -->
        <div class="relative py-16 md:py-20 px-8 flex flex-col items-center text-center gap-6">
            <!-- Ornement supérieur -->
            <div class="flex items-center justify-center gap-2">
                <div class="h-px w-20 bg-gradient-to-r from-transparent to-amber-200/50"></div>
                <span class="size-1.5 rotate-45 bg-amber-200/70"></span>
                <span class="size-2.5 rotate-45 bg-amber-200/90 shadow-[0_0_10px_rgba(251,191,36,0.6)]"></span>
                <span class="size-1.5 rotate-45 bg-amber-200/70"></span>
                <div class="h-px w-20 bg-gradient-to-l from-transparent to-amber-200/50"></div>
            </div>

            <!-- Titre principal -->
            <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold uppercase tracking-[0.15em] text-elyndra-gradient drop-shadow-[0_2px_20px_rgba(0,0,0,0.8)]">
                Début de l'Aventure
            </h1>

            <!-- Ornement inférieur -->
            <div class="flex items-center justify-center gap-2">
                <div class="h-px w-20 bg-gradient-to-r from-transparent to-amber-200/50"></div>
                <span class="size-1.5 rotate-45 bg-amber-200/70"></span>
                <span class="size-2.5 rotate-45 bg-amber-200/90 shadow-[0_0_10px_rgba(251,191,36,0.6)]"></span>
                <span class="size-1.5 rotate-45 bg-amber-200/70"></span>
                <div class="h-px w-20 bg-gradient-to-l from-transparent to-amber-200/50"></div>
            </div>

            <!-- Description -->
            <p class="text-sm md:text-base uppercase tracking-[0.2em] max-w-2xl leading-relaxed text-white/90 mt-4">
                Tout ce que vous devez savoir pour commencer l'aventure
            </p>
        </div>
    </div>
</section>

<!-- Séparateur avec losange -->
<div class="relative w-full py-8">
    <div class="absolute inset-0 flex items-center justify-center">
        <div class="h-px w-full bg-gradient-to-r from-transparent via-amber-200/30 to-transparent"></div>
    </div>
    <div class="relative flex justify-center">
        <span class="size-4 rotate-45 bg-amber-200/90 shadow-[0_0_15px_rgba(251,191,36,0.7)]"></span>
    </div>
</div>

<!-- Section Biomes -->
<section class="py-16 px-6 md:px-12 lg:px-20">
    <!-- Conteneur avec bordure -->
    <div class="max-w-7xl mx-auto border border-amber-200/30 rounded-3xl p-8 md:p-12 lg:p-16">
        <!-- En-tête -->
        <div class="text-center mb-12">
            <h2 class="text-4xl md:text-5xl font-bold uppercase tracking-[0.12em] text-elyndra-gradient mb-4">
                Choisissez Votre Monde
            </h2>
            <p class="text-sm md:text-base uppercase tracking-[0.18em] text-white/80">
                Sélectionne un biome pour commencer ta quête
            </p>
        </div>

        <!-- Grille de cartes -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
            {biomes.map((biome) => (
                <a
                    href={biome.link}
                    class="group relative overflow-hidden rounded-2xl transition-all duration-300 hover:shadow-[0_0_30px_rgba(251,191,36,0.3)]"
                >
                    <!-- Image de fond -->
                    <div class="relative h-80 md:h-96 overflow-hidden">
                        <img
                            src={biome.image.src}
                            alt={biome.title}
                            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                        />
                        <!-- Overlay gradient -->
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/95 via-slate-950/50 to-transparent"></div>
                    </div>

                    <!-- Contenu de la carte -->
                    <div class="absolute inset-0 flex flex-col justify-end p-6">
                        <!-- Cadre avec titre et description -->
                        <div class="border border-amber-200/40 rounded-xl p-6 backdrop-blur-sm bg-slate-950/30 transition-all duration-300 group-hover:border-amber-200/70 group-hover:bg-slate-950/50">
                            <!-- Ornement supérieur -->
                            <div class="flex items-center justify-center gap-2 mb-4">
                                <div class="h-px w-16 bg-gradient-to-r from-transparent to-amber-200/50"></div>
                                <span class="size-1 rotate-45 bg-amber-200/70"></span>
                                <span class="size-2 rotate-45 bg-amber-200/90 shadow-[0_0_8px_rgba(251,191,36,0.5)]"></span>
                                <span class="size-1 rotate-45 bg-amber-200/70"></span>
                                <div class="h-px w-16 bg-gradient-to-l from-transparent to-amber-200/50"></div>
                            </div>

                            <h3 class="text-xl md:text-2xl font-semibold text-center mb-4 text-amber-100 tracking-wide">
                                {biome.title}
                            </h3>

                            <!-- Ornement inférieur -->
                            <div class="flex items-center justify-center gap-2 mb-4">
                                <div class="h-px w-16 bg-gradient-to-r from-transparent to-amber-200/50"></div>
                                <span class="size-1 rotate-45 bg-amber-200/70"></span>
                                <span class="size-2 rotate-45 bg-amber-200/90 shadow-[0_0_8px_rgba(251,191,36,0.5)]"></span>
                                <span class="size-1 rotate-45 bg-amber-200/70"></span>
                                <div class="h-px w-16 bg-gradient-to-l from-transparent to-amber-200/50"></div>
                            </div>

                            <p class="text-sm text-center text-white/75 leading-relaxed">
                                {biome.description}
                            </p>
                        </div>
                    </div>
                </a>
            ))}
        </div>
    </div>
</section>
</Layout>

