---
import Layout from "../layout/Layout.astro";
import Pannel from "../components/Pannel.astro";
import CardsBiomes from "../components/Cards_biomes.astro";
import CardsRole from "../components/Cards_role.astro";
import Ornement from "../components/HeroOrnement.astro";
import BigSeparateur from "../components/BigSeparateur.astro";
import RecapTitle from "../components/RecapTitle.astro";
import heroImage from "../assets/hero_choix.webp";
import lunel from "../assets/biomes/lunel.webp";
import solarys from "../assets/biomes/solarys.webp";
import auralis from "../assets/biomes/auralis.webp";
import elyndra from "../assets/biomes/elyndra.webp";
import chevalier from "../assets/chevalier.webp";
import mage from "../assets/mage.webp";
import alchimiste from "../assets/alchimiste.webp";
import ombre from "../assets/ombre.webp";

const biomes = [
  {
    id: 1,
    title: "Le Cœur Sylvestre de Lunel",
    description:
      "Une jungle oppressante avec des cités perchées et des dangers au sol",
    image: lunel,
    link: "/interface_jeu/lunel",
  },
  {
    id: 2,
    title: "Les Dunes ardentes de Solarys",
    description:
      "Une immensité aride avec un oasis solitaire et un monde souterrain",
    image: solarys,
    link: "/interface_jeu/solarys",
  },
  {
    id: 3,
    title: "Le Village Gelé d'Auralis",
    description:
      "Un refuge givré avec des vents mordants et des spectres de glace",
    image: auralis,
    link: "/interface_jeu/auralis",
  },
  {
    id: 4,
    title: "Les Ruines Oubliées d'Élyndra",
    description:
      "Une cité perdue avec des pierres runiques et des légendes oubliées",
    image: elyndra,
    link: "/interface_jeu/elyndra",
  },
];

const roles = [
  {
    id: 1,
    slug: "Chevalier",
    title: "Le Chevalier",
    description: "Un guerrier en armure forgé dans l'acier et la bravoure",
    image: chevalier,
  },
  {
    id: 2,
    slug: "Mage",
    title: "La Mage",
    description: "Tisseuse de sorts, elle plie les éléments à sa volonté",
    image: mage,
  },
  {
    id: 3,
    slug: "Chimiste",
    title: "Le Chimiste",
    description:
      "Maître des potions et des runes, il transforme la nature en arme",
    image: alchimiste,
  },
  {
    id: 4,
    slug: "Ombre",
    title: "L'Ombre",
    description:
      "Assassin des ténèbres, il frappe vite et disparaît sans laisser de traces",
    image: ombre,
  },
];
---

<Layout>
  <section
    class="relative min-h-[380px] md:min-h-[500px] flex items-center justify-center"
  >
    <img
      src={heroImage.src}
      alt="Hero"
      class="absolute inset-0 w-full h-full object-cover"
    />
    <div class="absolute inset-0 bg-slate-950/40"></div>
    <div
      class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(0,0,0,0)_20%,rgba(0,0,0,0.7)_80%)]"
    >
    </div>
    <div
      class="relative flex flex-col items-center text-center gap-4 md:gap-6 py-12 md:py-20 px-6 md:px-8"
    >
      <Ornement />
      <h1
        class="text-elyndra-gradient text-3xl sm:text-4xl md:text-6xl lg:text-[4.5rem] font-bold uppercase tracking-widest md:tracking-[0.15em]"
      >
        Début de l'Aventure
      </h1>
      <Ornement />
      <p
        class="text-xs md:text-sm uppercase tracking-[0.15em] md:tracking-[0.2em] max-w-xs md:max-w-2xl leading-loose text-white/90 mt-2 md:mt-4"
      >
        Tout ce que vous devez savoir pour commencer l'aventure
      </p>
    </div>
  </section>

  <BigSeparateur />

  <div id="carousel-window" class="w-full relative">
    <div class="flex flex-col transition-transform">
      <!-- ════════════ PANNEAU 1 — BIOMES ════════════ -->
      <Pannel
        title="Choisissez Votre Monde"
        subtitle="Sélectionne un biome pour commencer ton aventure"
      >
        {
          biomes.map((biome) => (
            <div class="biome cursor-pointer" data-biome={biome.title}>
              <CardsBiomes
                image={biome.image.src}
                title={biome.title}
                description={biome.description}
              />
            </div>
          ))
        }
      </Pannel>

      <!-- ════════════ PANNEAU 2 — RÔLES ════════════ -->
      <Pannel
        title="Choisissez Votre Rôle"
        subtitle="Sélectionne ton archétype"
      >
        {
          roles.map((role) => (
            <div  class="role cursor-pointer" data-role={role.title}>
              <CardsRole
                image={role.image.src}
                title={role.title}
                description={role.description}
              />
            </div>
          ))
        }
      </Pannel>

      <!-- ════════════ PANNEAU 3 — PRÊT À JOUER ════════════ -->
      <div class="py-8 px-4">
        <div
          class="max-w-7xl mx-auto rounded-[10px] outline outline-Or-clair/60 p-6 md:p-14 flex flex-col items-center justify-center gap-6 md:gap-10"
        >
          <div class="relative flex items-center justify-center w-full">
            <div class="text-center px-12 md:px-0">
              <h2 class="panelTitle">Vous êtes prêt à jouer !</h2>
              <p class="panelSubtitle">Ton aventure commence maintenant</p>
            </div>
          </div>

          <div
            class="flex flex-col sm:flex-row items-stretch justify-center gap-4 md:gap-6 w-full max-w-2xl"
          >
            <div
              class="flex-1 flex flex-col items-center gap-2 md:gap-3 px-4 md:px-8 py-4 md:py-6 border border-Or-clair/35 rounded-[10px] bg-gradient-to-b from-Or-clair/5 to-transparent backdrop-blur-sm shadow-[0_0_20px_rgba(178,158,94,0.1)]"
            >
              <RecapTitle text="Biome" />
              <span
                id="recap-biome"
                class="text-sm md:text-base text-Or-clair font-heading2 tracking-wide text-center leading-snug"
              ></span>
            </div>

            <div class="flex sm:flex-col items-center justify-center shrink-0">
              <span
                class="size-2.5 rotate-45 bg-Or-clair/50 block shadow-[0_0_8px_rgba(251,191,36,0.4)]"
              ></span>
            </div>

            <div
              class="flex-1 flex flex-col items-center gap-2 md:gap-3 px-4 md:px-8 py-4 md:py-6 border border-Or-clair/35 rounded-[10px] bg-gradient-to-b from-Or-clair/5 to-transparent backdrop-blur-sm shadow-[0_0_20px_rgba(178,158,94,0.1)]"
            >
              <RecapTitle text="Rôle" />
              <span
                id="recap-role"
                class="text-sm md:text-base text-Or-clair font-heading2 tracking-wide text-center leading-snug"
              ></span>
            </div>

          </div>

          <!-- Nom -->
          <div
            class="flex flex-col sm:flex-row items-stretch justify-center gap-4 md:gap-6 w-full max-w-2xl"
          >
            <div
              class="flex-1 flex flex-col items-center gap-2 md:gap-3 px-4 md:px-8 py-4 md:py-6 border border-Or-clair/35 rounded-[10px] bg-gradient-to-b from-Or-clair/5 to-transparent backdrop-blur-sm shadow-[0_0_20px_rgba(178,158,94,0.1)]"
            >
              <RecapTitle text="Nom" />
              <input
                id="inputNom"
                type="text"
                class="text-sm w-full md:text-base text-Or-clair font-heading2 tracking-wide text-center leading-snug bg-none"
              >
            </div>
          </div>

          <!-- Bouton jouer -->
          <button
            id="play-btn"
            class="playBtn"
          >
              Commencer le jeu
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    let selectedBiome = null;
    let selectedRole  = null;
    let nom = null;

    const biomes = document.querySelectorAll(".biome");
    const biomeRecap = document.getElementById("recap-biome");
    const roles = document.querySelectorAll(".role");
    const roleRecap = document.getElementById("recap-role");

    const inputNom = document.getElementById("inputNom");

    const playBtn = document.getElementById("play-btn");

    if (biomes) {
        biomes.forEach((biome) => {
            biome.addEventListener("click", (e) => {
                selectedBiome = e.currentTarget?.getAttribute("data-biome");
                if (biomeRecap) {
                    biomeRecap.textContent = selectedBiome;
                }
                biomes.forEach((x) => {
                    x.children[0].classList.remove('border-Or-clair', 'shadow-[0_0_25px_rgba(251,191,36,0.5)]');
                })
                e.currentTarget?.children[0].classList.add('border-Or-clair', 'shadow-[0_0_25px_rgba(251,191,36,0.5)]');
                checkPlayable();
            })
        })
    }

    if (roles) {
        roles.forEach((role) => {
            role.addEventListener("click", (e) => {
                selectedRole = e.currentTarget?.getAttribute("data-role");
                if (roleRecap) {
                    roleRecap.textContent = selectedRole;
                }
                roles.forEach((x) => {
                    x.children[0].classList.remove('border-Or-clair', 'shadow-[0_0_25px_rgba(251,191,36,0.5)]');
                })
                e.currentTarget?.children[0].classList.add('border-Or-clair', 'shadow-[0_0_25px_rgba(251,191,36,0.5)]');
                checkPlayable();
            })
        })
    }

    if (inputNom) {
        inputNom.addEventListener("change", (e) => {
            nom = inputNom.value;
            checkPlayable();
        })
    }

    function checkPlayable() {
        if (playBtn) {
            if (selectedBiome && selectedRole && nom && nom != "") {
                playBtn.classList.remove("!shadow-none","hover:!shadow-none","opacity-50");
                playBtn.disabled = false;
            } else {
                playBtn.classList.add("!shadow-none","hover:!shadow-none","opacity-50");
                playBtn.disabled = true;
            }
        }
    }

    checkPlayable()

    if (playBtn) {
        playBtn.addEventListener("click", (e) => {
            
        })
    }
  </script>
</Layout>
