---
import Layout from "../layout/Layout.astro";
import CardsBiomes from "../components/Cards_biomes.astro";
import Ornement from "../components/HeroOrnement.astro";
import BigSeparateur from "../components/BigSeparateur.astro";
import heroImage from "../assets/hero_choix.webp";
import lunel from "../assets/biomes/lunel.webp";
import solarys from "../assets/biomes/solarys.webp";
import auralis from "../assets/biomes/auralis.webp";
import elyndra from "../assets/biomes/elyndra.webp";
import chevalier from "../assets/chevalier.webp";
import mage from "../assets/mage.webp";
import alchimiste from "../assets/alchimiste.webp";
import ombre from "../assets/ombre.webp";

const biomes = [
    { id: 1, title: "Le Cœur Sylvestre de Lunel", description: "Une jungle oppressante avec des cités perchées et des dangers au sol", image: lunel, link: "/interface_jeu/lunel" },
    { id: 2, title: "Les Dunes ardentes de Solarys", description: "Une immensité aride avec un oasis solitaire et un monde souterrain", image: solarys, link: "/interface_jeu/solarys" },
    { id: 3, title: "Le Village Gelé d'Auralis", description: "Un refuge givré avec des vents mordants et des spectres de glace", image: auralis, link: "/interface_jeu/auralis" },
    { id: 4, title: "Les Ruines Oubliées d'Élyndra", description: "Une cité perdue avec des pierres runiques et des légendes oubliées", image: elyndra, link: "/interface_jeu/elyndra" }
];

const roles = [
    { id: 1, slug: "Chevalier", title: "Le Chevalier", description: "Un guerrier en armure forgé dans l'acier et la bravoure", image: chevalier },
    { id: 2, slug: "Mage", title: "La Mage", description: "Tisseuse de sorts, elle plie les éléments à sa volonté", image: mage },
    { id: 3, slug: "Chimiste", title: "Le Chimiste", description: "Maître des potions et des runes, il transforme la nature en arme", image: alchimiste },
    { id: 4, slug: "Ombre", title: "L'Ombre", description: "Assassin des ténèbres, il frappe vite et disparaît sans laisser de traces", image: ombre }
];
---

<Layout>
    <section class="relative min-h-[380px] md:min-h-[500px] flex items-center justify-center">
        <img src={heroImage.src} alt="Hero" class="absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-slate-950/40"></div>
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(0,0,0,0)_20%,rgba(0,0,0,0.7)_80%)]"></div>
        <div class="relative flex flex-col items-center text-center gap-4 md:gap-6 py-12 md:py-20 px-6 md:px-8">
            <Ornement/>
            <h1 class="text-elyndra-gradient text-3xl sm:text-4xl md:text-6xl lg:text-[4.5rem] font-bold uppercase tracking-[0.1em] md:tracking-[0.15em]">
                Début de l'Aventure
            </h1>
            <Ornement/>
            <p class="text-xs md:text-sm uppercase tracking-[0.15em] md:tracking-[0.2em] max-w-xs md:max-w-2xl leading-loose text-white/90 mt-2 md:mt-4">
                Tout ce que vous devez savoir pour commencer l'aventure
            </p>
        </div>
    </section>

    <BigSeparateur/>

    <div id="carousel-window" class="w-full overflow-hidden relative">
        <div
            id="steps-track"
            class="flex transition-transform duration-700 ease-in-out"
            style="width:300%;transform:translateX(0);"
        >

            <!-- ════════════ PANNEAU 1 — BIOMES ════════════ -->
            <div class="shrink-0 py-8 md:py-16 px-4 md:px-[5vw]" style="width:33.333%;">
                <div class="max-w-7xl mx-auto border border-Or-clair/30 rounded-2xl md:rounded-3xl p-4 md:p-8 lg:p-12">
                    <div class="text-center mb-6 md:mb-12">
                        <h2 class="text-elyndra-gradient font-heading2 text-2xl sm:text-3xl md:text-5xl uppercase tracking-[0.08em] md:tracking-[0.12em] mb-3 md:mb-4">
                            Choisissez Votre Monde
                        </h2>
                        <p class="text-xs md:text-sm uppercase tracking-[0.12em] md:tracking-[0.18em] text-white/80">
                            Sélectionne un biome pour commencer ton aventure
                        </p>
                    </div>

                    <!-- 1 colonne sur mobile, 2 sur md+ -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
                        {biomes.map((biome) => (
                            <CardsBiomes image={biome.image.src} title={biome.title} description={biome.description}/>
                        ))}
                    </div>
                </div>
            </div>

            <!-- ════════════ PANNEAU 2 — RÔLES ════════════ -->
            <div class="shrink-0 py-8 md:py-16 px-4 md:px-[5vw]" style="width:33.333%;">
                <div class="max-w-7xl mx-auto rounded-[10px] outline outline-2 outline-Or-clair/40">
                    <div class="p-4 sm:p-6 md:p-14 flex flex-col gap-4 md:gap-6">

                        <!-- En-tête -->
                        <div class="relative flex items-center justify-center mb-0 md:mb-2">
                            <button
                                id="role-back-btn"
                                class="absolute left-0 flex items-center justify-center w-10 h-10 md:w-16 md:h-16 bg-transparent border-none cursor-pointer transition-opacity duration-200 hover:opacity-70"
                                aria-label="Retour aux biomes"
                            >
                                <!-- SVG réduit sur mobile -->
                                <svg class="w-8 h-7 md:w-[62px] md:h-[57px]" viewBox="0 0 62 57" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M21.333 45.5c0-1.802-1.771-4.493-3.564-6.751-2.306-2.915-5.06-5.457-8.22-7.398C7.182 29.896 4.31 28.5 2 28.5m0 0c2.31 0 5.184-1.396 7.55-2.851 3.158-1.943 5.913-4.486 8.219-7.395 1.793-2.261 3.564-4.957 3.564-6.754M2 28.5h58" stroke="#FFE9B5" stroke-width="2" stroke-linecap="square"/>
                                </svg>
                            </button>
                            <div class="text-center px-12 md:px-0">
                                <h2 class="text-elyndra-gradient font-heading2 text-xl sm:text-2xl md:text-5xl uppercase tracking-[0.08em] md:tracking-[0.12em] mb-1 md:mb-2">
                                    Choisissez Votre Rôle
                                </h2>
                                <p class="text-xs md:text-sm uppercase tracking-[0.12em] md:tracking-[0.18em] text-white/80">
                                    Sélectionner votre rôle préféré
                                </p>
                                <div class="flex items-center justify-center gap-2 mt-1">
                                    <span class="text-[0.6rem] md:text-xs uppercase tracking-widest text-Or-clair font-body">Monde :</span>
                                    <span id="selected-biome-label" class="text-[0.6rem] md:text-xs uppercase tracking-widest text-Or-clair font-semibold font-body"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Grille rôles : 1 colonne mobile, 2 colonnes md+ -->
                        <div class="p-3 md:p-6 rounded-[10px] outline outline-1 outline-Or-clair/40 grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-6">
                            {roles.map((role) => (
                                <button
                                    class="role-card group relative w-full h-56 sm:h-64 md:h-72 rounded-xl md:rounded-2xl overflow-hidden cursor-pointer bg-transparent border-none transition-all duration-300 hover:outline hover:outline-1 hover:outline-Or-clair/60 hover:shadow-[0_0_20px_rgba(251,191,36,0.25)]"
                                    data-role-slug={role.slug}
                                    data-role-title={role.title}
                                >
                                    <div class="absolute inset-x-4 md:inset-x-6 inset-y-3 md:inset-y-4 bg-zinc-700 rounded-[10px]"></div>
                                    <img
                                        src={role.image.src}
                                        alt={role.title}
                                        class="role-img absolute left-1/2 -translate-x-1/2 top-3 md:top-4 h-[calc(100%-0.75rem)] md:h-[calc(100%-1rem)] w-auto object-contain z-10 transition-transform duration-500 group-hover:scale-105"
                                    />
                                    <div class="absolute inset-x-4 md:inset-x-6 bottom-3 md:bottom-4 h-16 md:h-20 bg-black rounded-[10px] z-20 flex flex-col items-center justify-center gap-1">
                                        <div class="absolute top-0 inset-x-0 h-0.5 bg-Or-clair/80"></div>
                                        <span class="text-white text-sm md:text-base font-heading2 tracking-wide text-center">
                                            {role.title}
                                        </span>
                                        <p class="text-white/60 text-[0.65rem] md:text-xs font-body leading-tight text-center px-2 hidden sm:block">
                                            {role.description}
                                        </p>
                                    </div>
                                </button>
                            ))}
                        </div>

                    </div>
                </div>
            </div>

            <!-- ════════════ PANNEAU 3 — PRÊT À JOUER ════════════ -->
            <div class="shrink-0 py-8 md:py-16 px-4 md:px-[5vw]" style="width:33.333%;">
                <div class="max-w-7xl mx-auto rounded-[10px] outline outline-2 outline-Or-clair/60 p-6 md:p-14 flex flex-col items-center justify-center gap-6 md:gap-10">

                    <!-- En-tête -->
                    <div class="relative flex items-center justify-center w-full">
                        <button
                            id="confirm-back-btn"
                            class="absolute left-0 flex items-center justify-center w-10 h-10 md:w-16 md:h-16 bg-transparent border-none cursor-pointer transition-opacity duration-200 hover:opacity-70"
                            aria-label="Retour aux rôles"
                        >
                            <svg class="w-8 h-7 md:w-[62px] md:h-[57px]" viewBox="0 0 62 57" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M21.333 45.5c0-1.802-1.771-4.493-3.564-6.751-2.306-2.915-5.06-5.457-8.22-7.398C7.182 29.896 4.31 28.5 2 28.5m0 0c2.31 0 5.184-1.396 7.55-2.851 3.158-1.943 5.913-4.486 8.219-7.395 1.793-2.261 3.564-4.957 3.564-6.754M2 28.5h58" stroke="#FFE9B5" stroke-width="2" stroke-linecap="square"/>
                            </svg>
                        </button>
                        <div class="text-center px-12 md:px-0">
                            <h2 class="text-elyndra-gradient font-heading2 text-xl sm:text-2xl md:text-5xl uppercase tracking-[0.08em] md:tracking-[0.12em] mb-1 md:mb-2">
                                Vous êtes prêt à jouer !
                            </h2>
                            <p class="text-xs md:text-sm uppercase tracking-[0.12em] md:tracking-[0.18em] text-white/80">
                                Ton aventure commence maintenant
                            </p>
                        </div>
                    </div>

                    <!-- Récap encadré : empilé sur mobile, côte à côte sur md+ -->
                    <div class="flex flex-col sm:flex-row items-stretch justify-center gap-4 md:gap-6 w-full max-w-2xl">
                        <!-- Carte Monde -->
                        <div class="flex-1 flex flex-col items-center gap-2 md:gap-3 px-4 md:px-8 py-4 md:py-6 border border-Or-clair/35 rounded-[10px] bg-gradient-to-b from-Or-clair/5 to-transparent backdrop-blur-sm shadow-[0_0_20px_rgba(178,158,94,0.1)]">
                            <div class="flex items-center gap-2">
                                <div class="h-px w-5 bg-Or-clair/40"></div>
                                <span class="text-[0.6rem] md:text-[0.65rem] uppercase tracking-[0.2em] text-Or-clair/55 font-body">Monde</span>
                                <div class="h-px w-5 bg-Or-clair/40"></div>
                            </div>
                            <span id="recap-biome" class="text-sm md:text-base text-Or-clair font-heading2 tracking-wide text-center leading-snug"></span>
                        </div>

                        <!-- Losange séparateur : horizontal sur mobile, vertical sur sm+ -->
                        <div class="flex sm:flex-col items-center justify-center shrink-0">
                            <span class="size-2.5 rotate-45 bg-Or-clair/50 block shadow-[0_0_8px_rgba(251,191,36,0.4)]"></span>
                        </div>

                        <!-- Carte Rôle -->
                        <div class="flex-1 flex flex-col items-center gap-2 md:gap-3 px-4 md:px-8 py-4 md:py-6 border border-Or-clair/35 rounded-[10px] bg-gradient-to-b from-Or-clair/5 to-transparent backdrop-blur-sm shadow-[0_0_20px_rgba(178,158,94,0.1)]">
                            <div class="flex items-center gap-2">
                                <div class="h-px w-5 bg-Or-clair/40"></div>
                                <span class="text-[0.6rem] md:text-[0.65rem] uppercase tracking-[0.2em] text-Or-clair/55 font-body">Rôle</span>
                                <div class="h-px w-5 bg-Or-clair/40"></div>
                            </div>
                            <span id="recap-role" class="text-sm md:text-base text-Or-clair font-heading2 tracking-wide text-center leading-snug"></span>
                        </div>
                    </div>

                    <!-- Bouton jouer -->
                    <a
                        id="play-btn"
                        href="#"
                        class="inline-flex items-center justify-center gap-3 px-6 md:px-10 py-4 md:py-5 bg-elyndra-3 rounded-[10px] no-underline transition-all duration-300 shadow-[0_0_20px_rgba(251,191,36,0.2)] hover:shadow-[0_0_35px_rgba(251,191,36,0.45)]"
                    >
                        <span class="text-Blanc text-base md:text-xl font-body font-semibold">
                            Commencer le jeu
                        </span>
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4 md:size-5 text-text-color-2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                        </svg>
                    </a>

                    <!-- Recommencer -->
                    <button
                        id="restart-btn"
                        class="bg-transparent border-none cursor-pointer text-sous-texte text-sm md:text-base font-body tracking-wide underline underline-offset-4 transition-colors duration-200 hover:text-white/75"
                    >
                        Ou recommencer vos choix
                    </button>

                </div>
            </div>

        </div>
    </div>

</Layout>

