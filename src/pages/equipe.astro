---
import Layout from "../layout/Layout.astro";
import heroImage from "../assets/hero_equipe.webp";
import teamImage from "../assets/team-illustration.webp";
// Importe les images de projets
import experienceImg from "../assets/work/experience.webp";
import developpementImg from "../assets/work/developpement.webp";
import collaborationImg from "../assets/work/collaboration.webp";

const projects = [
    {
        title: "Elyndra - L'Expérience Interactive",
        description: "Notre projet phare : un jeu narratif immersif où l'IA conversationnelle rencontre le storytelling interactif. Chaque conversation façonne votre histoire unique.",
        image: experienceImg,
        stats: ["IA Conversationnelle", "Storytelling Adaptatif", "Univers Immersif"]
    },
    {
        title: "Développement Technique",
        description: "Une architecture robuste et évolutive, conçue pour offrir une expérience fluide et réactive. Technologies modernes et optimisations poussées.",
        image: developpementImg,
        stats: ["Stack Moderne", "Performance Optimale", "Code Maintenable"]
    },
    {
        title: "Collaboration d'Équipe",
        description: "Un travail d'équipe harmonieux où chaque membre apporte son expertise unique. De la conception à la réalisation, chaque détail compte.",
        image: collaborationImg,
        stats: ["3 Membres", "Passion Dévolue", "Vision Commune"]
    }
];

const team = [
    {
        name: "Margaux Couturier",
        role: "Narratrice",
        description: "Architecte d'histoires immersives. Maître dans l'art du storytelling interactif et de la création de mondes."
    },
    {
        name: "Paolo Vincent",
        role: "Développeur",
        description: "Passionné par l'innovation technique et l'architecture logicielle. Expert en développement full-stack et optimisation."
    },
    {
        name: "François Yang",
        role: "Designer",
        description: "Créateur d'expériences visuelles uniques. Spécialisé dans l'UI/UX et la direction artistique."
    }
];
---

<Layout>
<!-- Hero -->
<section class="hero flex items-center justify-center">
    <div class="w-full relative h-full">
        <!-- Image de fond -->
        <img
            src={heroImage.src}
            alt="Hero background"
            class="absolute inset-0 w-full h-full object-cover"
        />

        <!-- Overlay assombrissement + vignette -->
        <div class="absolute inset-0 bg-slate-950/40"></div>
        <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(0,0,0,0)_20%,rgba(0,0,0,0.7)_80%)]"></div>

        <!-- Contenu -->
        <div class="relative py-16 md:py-20 px-8 flex flex-col items-center text-center gap-6">
            <!-- Ornement supérieur -->
            <div class="flex items-center justify-center gap-2">
                <div class="h-px w-20 bg-gradient-to-r from-transparent to-amber-200/50"></div>
                <span class="size-1.5 rotate-45 bg-amber-200/70"></span>
                <span class="size-2.5 rotate-45 bg-amber-200/90 shadow-[0_0_10px_rgba(251,191,36,0.6)]"></span>
                <span class="size-1.5 rotate-45 bg-amber-200/70"></span>
                <div class="h-px w-20 bg-gradient-to-l from-transparent to-amber-200/50"></div>
            </div>

            <!-- Titre principal -->
            <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold uppercase tracking-[0.10em] md:tracking-[0.15em] text-elyndra-gradient drop-shadow-[0_2px_20px_rgba(0,0,0,0.8)]">
                Qui sommes nous ?
            </h1>

            <!-- Ornement inférieur -->
            <div class="flex items-center justify-center gap-2">
                <div class="h-px w-20 bg-gradient-to-r from-transparent to-amber-200/50"></div>
                <span class="size-1.5 rotate-45 bg-amber-200/70"></span>
                <span class="size-2.5 rotate-45 bg-amber-200/90 shadow-[0_0_10px_rgba(251,191,36,0.6)]"></span>
                <span class="size-1.5 rotate-45 bg-amber-200/70"></span>
                <div class="h-px w-20 bg-gradient-to-l from-transparent to-amber-200/50"></div>
            </div>

            <!-- Description -->
            <p class="text-sm md:text-base uppercase tracking-[0.2em] max-w-2xl leading-relaxed text-white/90 mt-4">
                Des étudiants passionnés, un objectif commun, zéro compromis sur l'ambition.
            </p>
        </div>
    </div>
</section>

<!-- Section Équipe -->
<section class="py-16 px-6 md:px-12 lg:px-20">
    <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center">
            
            <!-- Colonne gauche : Texte -->
            <div class="space-y-6 text-white/85">
                <p class="text-base leading-relaxed">
                    <span class="text-amber-200 font-semibold">Élyndra</span> est né de ton envie de créer quelque chose qui te passionne vraiment. Plus qu'une histoire à raconter, c'est un monde entier que tu imagines, que tu construis et que tu fais vivre.
                </p>

                <p class="text-base leading-relaxed">
                    L'expérience s'appuie sur une intelligence conversationnelle avancée, pour que chaque voyage soit unique et personnel. À travers tes choix et tes échanges, tu évolues au sein d'un fil d'une aventure qui s'adapte à ta manière de jouer.
                </p>

                <p class="text-base leading-relaxed">
                    Ton objectif est simple : concevoir une expérience interactive immersive où tu n'es pas seulement spectateur, mais véritable acteur. Chaque décision compte, chaque interaction laisse une trace et influence la suite du parcours.
                </p>

                <p class="text-base leading-relaxed">
                    Derrière Élyndra, tu retrouves une équipe de trois étudiants, réunis par la même envie : créer, expérimenter et donner vie à une vision commune.
                </p>
            </div>

            <!-- Colonne droite : Image -->
            <div class="relative overflow-hidden rounded-2xl">
                <img
                    src={teamImage.src}
                    alt="Illustration Élyndra"
                    class="w-full h-auto object-cover"
                />
            </div>

        </div>
    </div>
</section>

<!-- Section Notre Travail --> 
<section class="py-20 px-6">
    <div class="container mx-auto max-w-6xl">
        <!-- Titre de la section -->
        <div class="text-center mb-12">
            <!-- Ornement supérieur -->
            <div class="flex items-center justify-center gap-2 mb-6">
                <div class="h-px w-20 bg-gradient-to-r from-transparent to-amber-200/50"></div>
                <span class="size-1.5 rotate-45 bg-amber-200/70"></span>
                <span class="size-2.5 rotate-45 bg-amber-200/90 shadow-[0_0_10px_rgba(251,191,36,0.6)]"></span>
                <span class="size-1.5 rotate-45 bg-amber-200/70"></span>
                <div class="h-px w-20 bg-gradient-to-l from-transparent to-amber-200/50"></div>
            </div>

            <h2 class="text-3xl md:text-5xl font-bold uppercase tracking-[0.10em] md:tracking-[0.12em] text-elyndra-gradient">
                Notre Travail
            </h2>

            <!-- Ornement inférieur -->
            <div class="flex items-center justify-center gap-2 mt-6">
                <div class="h-px w-20 bg-gradient-to-r from-transparent to-amber-200/50"></div>
                <span class="size-1.5 rotate-45 bg-amber-200/70"></span>
                <span class="size-2.5 rotate-45 bg-amber-200/90 shadow-[0_0_10px_rgba(251,191,36,0.6)]"></span>
                <span class="size-1.5 rotate-45 bg-amber-200/70"></span>
                <div class="h-px w-20 bg-gradient-to-l from-transparent to-amber-200/50"></div>
            </div>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
            {projects.map((project, index) => (
                <div class="group relative bg-gradient-to-b from-zinc-900 to-black border border-amber-200/20 rounded-lg overflow-hidden hover:border-amber-200/50 transition-all duration-300">
                    <!-- Image -->
                    <div class="relative h-48 overflow-hidden">
                        <img
                            src={project.image.src}
                            alt={project.title}
                            class="w-full h-full object-cover opacity-60 group-hover:opacity-80 group-hover:scale-110 transition-all duration-500"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent"></div>
                        
                        <!-- Icône en haut à droite -->
                        <div class="absolute top-4 right-4 bg-amber-200/10 backdrop-blur-sm p-3 rounded-lg border border-amber-200/30">
                            {index === 0 && (
                                <!-- Sparkles icon -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                                </svg>
                            )}
                            {index === 1 && (
                                <!-- Code icon -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                                </svg>
                            )}
                            {index === 2 && (
                                <!-- Users icon -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-amber-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                                </svg>
                            )}
                        </div>
                    </div>

                    <!-- Content (texte aligné à gauche) -->
                    <div class="p-6 text-left">
                        <h3 class="text-xl text-amber-100 mb-3 tracking-wide">
                            {project.title}
                        </h3>
                        <p class="text-gray-400 text-sm mb-4 leading-relaxed">
                            {project.description}
                        </p>

                        <!-- Stats -->
                        <div class="flex flex-wrap gap-2">
                            {project.stats.map((stat) => (
                                <span class="text-xs bg-amber-200/10 text-amber-100 px-3 py-1 rounded-full border border-amber-200/20">
                                    {stat}
                                </span>
                            ))}
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<!-- Section Rejoindre l'équipe -->
<!-- Titre de la section -->
<div class="text-center mb-12">
    <!-- Ornement supérieur -->
    <div class="flex items-center justify-center gap-2 mb-6">
        <div class="h-px w-20 bg-gradient-to-r from-transparent to-amber-200/50"></div>
        <span class="size-1.5 rotate-45 bg-amber-200/70"></span>
        <span class="size-2.5 rotate-45 bg-amber-200/90 shadow-[0_0_10px_rgba(251,191,36,0.6)]"></span>
        <span class="size-1.5 rotate-45 bg-amber-200/70"></span>
        <div class="h-px w-20 bg-gradient-to-l from-transparent to-amber-200/50"></div>
    </div>

    <h2 class="text-3xl md:text-5xl font-bold uppercase tracking-[0.10em] md:tracking-[0.12em] text-elyndra-gradient">
        L'équipe
    </h2>

    <!-- Ornement inférieur -->
    <div class="flex items-center justify-center gap-2 mt-6">
        <div class="h-px w-20 bg-gradient-to-r from-transparent to-amber-200/50"></div>
        <span class="size-1.5 rotate-45 bg-amber-200/70"></span>
        <span class="size-2.5 rotate-45 bg-amber-200/90 shadow-[0_0_10px_rgba(251,191,36,0.6)]"></span>
        <span class="size-1.5 rotate-45 bg-amber-200/70"></span>
        <div class="h-px w-20 bg-gradient-to-l from-transparent to-amber-200/50"></div>
    </div>
</div>

<!-- Section Équipe -->
<section class="py-20 px-6">
    <div class="max-w-6xl mx-auto">
        <!-- Grille de cartes -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {team.map((member) => (
                <div class="relative flex justify-center">
                    <!-- Losange doré en haut -->
                    <div class="absolute -top-3 z-10">
                        <div class="w-3.5 h-3.5 rotate-45 bg-Or-clair shadow-[0_0_15px_rgba(255,233,181,0.6)]"></div>
                    </div>

                    <!-- Rectangle carte -->
                    <div class="w-full max-w-[20rem] sm:w-80 bg-black rounded-3xl border border-amber-200/30 flex flex-col items-center pt-14 pb-10 px-6 sm:px-8 gap-5">
                        
                        <!-- Avatar avec dégradé Or-clair et icône NOIRE -->
                        <div class="w-24 h-24 bg-gradient-to-b from-Or-clair to-Or-clair/50 rounded-full p-[2px] inline-flex justify-center items-center shadow-[0_0_20px_rgba(255,233,181,0.3)]">
                            <div class="w-full h-full bg-gradient-to-b from-Or-clair to-Or-clair/50 rounded-full flex items-center justify-center">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-12 h-12 text-black" fill="currentColor" viewBox="0 0 24 24">
                                    <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                                </svg>
                            </div>
                        </div>

                        <!-- Nom en BLANC avec Cinzel Decorative -->
                        <h3 class="text-center text-white text-xl font-light font-heading tracking-wider">
                            {member.name}
                        </h3>

                        <!-- Rôle en Or-clair avec Volkhov (font-body) -->
                        <p class="text-center text-Or-clair text-[11px] font-body font-normal tracking-[0.25em] uppercase">
                            {member.role}
                        </p>

                        <!-- Ornement ligne + losange + ligne en Or-clair -->
                        <div class="flex items-center justify-center gap-2 w-full">
                            <div class="h-px w-20 bg-gradient-to-r from-transparent via-Or-clair/60 to-Or-clair/60"></div>
                            <div class="w-1.5 h-1.5 rotate-45 bg-Or-clair flex-shrink-0"></div>
                            <div class="h-px w-20 bg-gradient-to-l from-transparent via-Or-clair/60 to-Or-clair/60"></div>
                        </div>

                        <!-- Description en gris -->
                        <p class="text-center text-gray-400 text-xs font-body leading-relaxed">
                            {member.description}
                        </p>
                    </div>
                </div>
            ))}
        </div>

        <!-- Citation -->
<div class="mt-20 text-center relative max-w-4xl mx-auto">
    
    <!-- Guillemet ouverture -->
    <div class="leading-none mb-1">
        <span class="text-Or-clair text-6xl md:text-7xl font-serif leading-none">"</span>
    </div>
    
    <!-- Première ligne en italique gris -->
    <p class="text-white/50 italic text-base md:text-xl font-body tracking-wider md:tracking-wider leading-relaxed mb-4 md:mb-6">
        NOUS NE RACONTONS PAS UNE HISTOIRE.
    </p>
    
    <!-- Deuxième ligne dorée avec espacement -->
    <p class="text-Or-clair text-base md:text-xl tracking-[0.15em] md:tracking-[0.35em] uppercase font-body leading-relaxed mb-6 md:mb-9">
        LE MONDE S'ÉCRIT À TRAVERS VOS CHOIX.
    </p>
    
    <!-- Guillemet fermeture -->
    <div class="leading-none">
        <span class="text-Or-clair text-6xl md:text-7xl font-serif leading-none">"</span>
    </div>
</div>


    </div>
</section>

</Layout>
