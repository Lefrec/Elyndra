              </div>
              <div class="userMessage">Message de l'utilisateur</div>
            </div>
          </div>
          <!-- input -->
          <div class="flex w-full gap-2 p-2">
            <div class="w-full">
              <input
                id="input"
                class="w-full p-2 border border-Or-clair rounded-xl"
                type="text"
              />
            </div>
            <button id="button" class="goldCard hover:bg-Or-clair/50"
              >Envoyer</button
            >
          </div>
        </div>
      </div>
      <!-- right col -->
      <div class="h-full lg:w-1/5">
        <div class="goldCard">
          <h3 class="goldTitle">Statistiques</h3>
          <p class="self-center">{player.class}</p>
          <!-- tableau des stats -->
          <div
            class="grid grid-cols-4 self-center lg:grid-cols-2 lg:max-w-40 gap-2 p-4"
          >
            <div class="goldCell">
              <Epee />
            </div>
            <div class="goldCell">
              <p id="for">{player.for}</p>
            </div>
            <div class="goldCell">
              <Bouclier />
            </div>
            <div class="goldCell">
              <p id="def">{player.def}</p>
            </div>
            <div class="goldCell">
              <Magie />
            </div>
            <div class="goldCell">
              <p id="mag">{player.mag}</p>
            </div>
            <div class="goldCell">
              <Pied />
            </div>
            <div class="goldCell">
              <p id="agi">{player.agi}</p>
            </div>
          </div>
        </div>
        <!-- inventaire -->
        <div class="goldCard h-full max-h-50 lg:max-h-100">
          <h3 class="goldTitle">Inventaire</h3>
          <div
            class="h-full flex flex-col max-h-50 lg:max-h-100 gap-4 overflow-y-scroll hide-scrollbar"
          >
            {
              Array.isArray(inventory)
                ? inventory.map((item) => (
                    <div class="flex w-full items-center">
                      <div class="flex flex-col w-full gap-1">
                        <p>{item.name}</p>
                        <p class="text-xs text-white/75">{item.desc}</p>
                      </div>
                      <p class="text-xs text-white/75">x{item.amount}</p>
                    </div>
                  ))
                : "Votre inventaire est vide"
            }
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- biomeState management -->
  <script>
    import { biomeState } from "../stores/biome.js";

    const biomes = {
      elyndra: {
        title: "Ruines d'Élyndra",
        image: "/biomes/elyndra.webp",
        desc: "Une cité perdue avec des pierres runiques",
      },
      lunel: {
        title: "Forêt de Lunel",
        image: "/biomes/lunel.webp",
        desc: "Une jungle oppressante avec des cités perchées",
      },
      solarys: {
        title: "Dunes de Solarys",
        image: "/biomes/solarys.webp",
        desc: "Une immensité aride avec un oasis solitaire",
      },
      auralis: {
        title: "Vallée gelée d'Auralis",
        image: "/biomes/auralis.webp",
        desc: "Un refuge givré avec des vents mordants",
      },
    };

    biomeState.subscribe(() => {
      const state = biomeState.get();
      document.getElementById("bgImage").src = state.image;
      document.getElementById("title").textContent = state.title;
      document.getElementById("lieuTitle").textContent =
        "Lieu - " + state.title;
      document.getElementById("lieuDesc").textContent = state.desc;
    });

    function randomizeBiome() {
      const index =
        Object.keys(biomes)[(Math.random() * Object.keys(biomes).length) | 0];
      biomeState.set(biomes[index]);
    }

    // console.log("randomize");
    // randomizeBiome();
  </script>

  <!-- diceState management -->
  <script>
    import { diceState } from "../stores/dice";

    diceState.subscribe(() => {
      const state = diceState.get();
      const anim = document
        .getElementById("dice")
        .animate(
          [{ transform: "rotate(0deg)" }, { transform: "rotate(720deg)" }],
          {
            duration: 800,
            easing: "cubic-bezier(0.25, 0.46, 0.45, 0.94)", // easeOutQuad
          },
        );

      anim.onfinish = () => {
        document.getElementById("dice-result").textContent = state.result;
      };
    });

    function randomizeResult() {
      diceState.set({ result: Math.ceil(Math.random() * 20) });
    }

    // randomizeResult();
  </script>

  <!-- side menu toggle -->
  <script>
    const menuToggle = document.getElementById("menu-toggle");
    const sideMenu = document.getElementById("side-menu");
    const menuOverlay = document.getElementById("menu-overlay");
    const closeMenuBtn = document.getElementById("close-menu");

    let menuOpen = false;

    function toggleMenu() {
      menuOpen = !menuOpen;

      if (menuOpen) {
        // Ouvrir le menu
        sideMenu.classList.remove("translate-x-full");
        menuOverlay.classList.remove("opacity-0", "pointer-events-none");

        // Cacher le bouton hamburger
        menuToggle.style.opacity = "0";
        menuToggle.style.pointerEvents = "none";
      } else {
        // Fermer le menu
        sideMenu.classList.add("translate-x-full");
        menuOverlay.classList.add("opacity-0", "pointer-events-none");

        // Réafficher le bouton hamburger
        menuToggle.style.opacity = "1";
        menuToggle.style.pointerEvents = "auto";
      }
    }

    menuToggle.addEventListener("click", toggleMenu);
    closeMenuBtn.addEventListener("click", toggleMenu);
    menuOverlay.addEventListener("click", toggleMenu);
  </script>

  <!-- scrolling to bottom of chat -->
  <script>
    function scrollToBottom() {
      const container = document.getElementById("messages-container");
      container.scrollTop = container.scrollHeight;
    }

    scrollToBottom();
  </script>

  <!-- verbomnes -->
  <script>
    const verbomnesButton = document.getElementById("verbomnes-button");
    const verbomnesModal = document.getElementById("verbomnes-modal");
    const closeVerbomnes = document.getElementById("close-verbomnes");

    function openVerbomnesModal() {
      verbomnesModal.classList.remove("opacity-0", "pointer-events-none");
      verbomnesModal.querySelector("div").classList.remove("scale-95");
      verbomnesModal.querySelector("div").classList.add("scale-100");
    }

    function closeVerbomnesModal() {
      verbomnesModal.classList.add("opacity-0", "pointer-events-none");
      verbomnesModal.querySelector("div").classList.remove("scale-100");
      verbomnesModal.querySelector("div").classList.add("scale-95");
    }

    verbomnesButton.addEventListener("click", openVerbomnesModal);
    closeVerbomnes.addEventListener("click", closeVerbomnesModal);

    // Fermer en cliquant sur l'overlay
    verbomnesModal.addEventListener("click", (e) => {
      if (e.target === verbomnesModal) {
        closeVerbomnesModal();
      }
    });
  </script>

  <!-- chat api endpoint -->
  <script>
    const button = document.getElementById("button") as HTMLButtonElement;
    const input = document.getElementById("input") as HTMLInputElement;
    const messagesContainer = document.getElementById("messages-container") as HTMLDivElement;

    let messages: Array<{ role: string; content: string }> = [];

    if (button && input && messagesContainer) {
    button.addEventListener("click", async () => {
      const userMessage = input.value.trim();
      if (!userMessage) return;

      messages.push({ role: "user", content: userMessage });

      const userMessageDiv = document.createElement("div");
      userMessageDiv.classList.add("userMessage");
      userMessageDiv.textContent = userMessage;
      messagesContainer.appendChild(userMessageDiv);

      input.value = "";

      const res = await fetch("/apiEndpoint/chat.json", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          messages: messages,
        }),
      });

      if (!res.ok) {
        const text = await res.text();
        messagesContainer.textContent = `Error ${res.status}: ${text}`;
        return;
      }

      const data = await res.json();

      messages.push({ role: "assistant", content: data.reply });

      const assistantMessageDiv = document.createElement("div");
      assistantMessageDiv.classList.add("assistantMessage");
      assistantMessageDiv.textContent = data.reply;
      messagesContainer.appendChild(assistantMessageDiv);
    });

    input.addEventListener("keypress", (e) => {
      if (e.key === "Enter") {
        button.click();
      }
    });
  }
  </script>
</Layout>
