---
import Layout from "../layout/Layout.astro";
import SmallSeparateur from "../components/SmallSeparateur.astro";
import Dice from "../assets/interface_ia/dice.svg";
import Burger from "../assets/interface_ia/menu-hamburger.svg";
import Epee from "../assets/interface_ia/stats/epee.svg";
import Bouclier from "../assets/interface_ia/stats/bouclier.svg";
import Magie from "../assets/interface_ia/stats/magie.svg";
import Pied from "../assets/interface_ia/stats/pied.svg";
import { biomeState } from "../stores/biome.js";
import { getPlayer } from "../../backend/functions/player";
import { listInventory } from "../../backend/functions/inventory";
import { listQuest } from "../../backend/functions/quest";
import { getDice } from "../../backend/functions/dice";

if (!Astro.locals.pb.authStore.record) {
  return Astro.redirect("/login");
}

const id = Astro.locals.pb.authStore.record.id;

let player;

player = await getPlayer(id);

let inventory;

inventory = await listInventory(id);

let quests;

quests = await listQuest(id);

let dice;

dice = await getDice(id);
---

<Layout title="Interface de jeu" hideHeaderFooter={true}>
  <!-- background -->
  <img
    id="bgImage"
    class="fixed w-full h-full lg:h-screen -z-1 object-cover"
    src={biomeState.get().image}
    alt=""
  />
  <div class="flex flex-col p-4 gap-4 lg:h-screen">
    <!-- header -->
    <header class="flex w-full justify-between">
      <button id="verbomnes-button" class="basicBtn">Vos Verbomnes</button>
      <button id="menu-toggle">
        <Burger />
      </button>
      <!-- Menu latéral -->
      <nav
        id="side-menu"
        class="fixed top-0 right-0 h-full w-80 bg-neutral-950 border-l border-Or-clair shadow-2xl transform translate-x-full transition-transform duration-300 ease-in-out z-40 overflow-y-auto"
      >
        <div class="p-6">
          <!-- Bouton fermer en haut à droite -->
          <button
            id="close-menu"
            class="absolute top-4 right-4 w-10 h-10 flex items-center justify-center bg-zinc-900 hover:bg-zinc-800 rounded transition-colors group"
          >
            <span
              class="text-Or-clair text-3xl leading-none group-hover:scale-110 transition-transform"
              >×</span
            >
          </button>

          <!-- En-tête du menu -->
          <div class="mb-8 pb-4 border-b border-Or-clair/30">
            <h2 class="text-Or-clair text-2xl">Menu</h2>
          </div>

          <!-- Navigation -->
          <ul class="space-y-4">
            <li>
              <a
                href="/"
                class="block px-4 py-3 text-white hover:text-Or-clair hover:bg-[#292929FF]/50 rounded transition-colors"
              >
                Accueil
              </a>
            </li>
            <li>
              <button
                id="save-btn"
                class="w-full text-left px-4 py-3 hover:text-Or-clair hover:bg-[#292929FF]/50 rounded transition-colors"
              >
                Sauvegarder
              </button>
            </li>
            <li>
              <button
                class="w-full text-left px-4 py-3 text-white hover:text-Or-clair hover:bg-[#292929FF]/50 rounded transition-colors"
              >
                Paramètres
              </button>
            </li>
            <li>
              <a
                href="/contact"
                class="block px-4 py-3 text-white hover:text-Or-clair hover:bg-[#292929FF]/50 rounded transition-colors"
              >
                Aide
              </a>
            </li>
          </ul>

          <!-- Retour -->
          <div class="mt-8 pt-6 border-t border-Or-clair/30">
            <a
              href="/"
              class="block w-full text-center px-4 py-3 bg-red-900 hover:bg-red-800 text-white rounded transition-colors"
            >
              ← Quitter l'aventure
            </a>
          </div>
        </div>
      </nav>
      <!-- Overlay pour fermer le menu -->
      <div
        id="menu-overlay"
        class="fixed inset-0 bg-black/50 opacity-0 pointer-events-none transition-opacity duration-300 z-30"
      >
      </div>
    </header>
    <!-- modal verbomnes -->
    <div
      id="verbomnes-modal"
      class="fixed inset-0 bg-black/70 flex items-center justify-center opacity-0 pointer-events-none transition-opacity duration-300 z-50"
    >
      <div
        class="relative bg-black border-2 border-Or-clair rounded-lg shadow-2xl max-w-4xl w-full mx-4 p-10 transform scale-95 transition-transform duration-300"
      >
        <!-- Bouton fermer -->
        <button
          id="close-verbomnes"
          class="absolute top-6 right-6 w-8 h-8 border-2 border-Or-clair hover:bg-Or-clair/20 transition-colors flex items-center justify-center"
        >
          <span class="text-Or-clair text-xl">×</span>
        </button>

        <!-- Titre -->
        <div class="mb-6">
          <h2
            class="text-Or-clair text-4xl font-['Cinzel_Decorative'] uppercase text-center tracking-[3px] mb-4"
          >
            L'Oracle des Verbomnes
          </h2>
          <SmallSeparateur />
        </div>

        <!-- Description -->
        <p
          class="text-center text-white text-base font-['Almendra'] tracking-wide mb-8"
        >
          Chaque parole façonne le destin. Mais même les dieux ont leurs
          limites.
        </p>

        <!-- Contenu principal -->
        <div
          class="flex flex-col md:flex-row gap-12 items-center justify-center mb-8"
        >
          <!-- Compteur de Verbomnes -->
          <div class="relative flex items-center justify-center py-8 md:py-0">
            <!-- Cercle décoratif -->
            <div
              class="absolute w-56 h-56 sm:w-72 sm:h-72 border border-Or-clair opacity-30 rounded-full shadow-[0px_4px_15px_0px_rgba(255,233,181,0.5)]"
            >
            </div>
            <div
              class="absolute w-44 h-44 sm:w-60 sm:h-56 border border-Or-clair opacity-20"
            >
            </div>

            <!-- Nombre et texte -->
            <div class="relative text-center z-10">
              <div
                class="text-Or-clair text-5xl sm:text-6xl font-['Cinzel_Decorative'] leading-none sm:leading-[96px] mb-2"
              >
                128
              </div>
              <div class="text-orange-200 text-sm sm:text-base tracking-widest">
                Verbomnes restants
              </div>
            </div>
          </div>

          <!-- Explications -->
          <div class="max-w-md space-y-6">
            <div>
              <h3 class="text-Or-clair text-lg tracking-wide mb-3">
                L'Oracle murmure encore
              </h3>
              <p class="text-white text-sm leading-5">
                Chaque action formulée par le joueur invoque l'Oracle. Lorsque
                toutes les Verbomnes ont été consommées, le récit ne peut plus
                se poursuivre.
              </p>
            </div>
            <div>
              <p class="text-white text-sm leading-5">
                L'Oracle d'Elyndra est animé par une intelligence artificielle
                de génération de langage, agissant comme narrateur dynamique
                dans un univers et des règles définis par les créateurs.
              </p>
            </div>

            <!-- Bouton membre -->
            <a
              href="/boutique"
              class="w-full px-4 py-3 bg-elyndra-3 hover:bg-yellow-600 transition-colors rounded-[10px] text-center"
            >
              <span class="text-white text-xs"
                >Découvrez nos offres pour plus de Verbomnes !</span
              >
            </a>
          </div>
        </div>
        <SmallSeparateur />
      </div>
    </div>
    <!-- title -->
    <div class="flex justify-center">
      <h1
        id="title"
        class="text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-bold font-heading text-Or-clair"
      >
        {biomeState.get().title}
      </h1>
    </div>
    <!-- main panel -->
    <div
      class="flex flex-col lg:flex-row border border-Or-clair bg-black/50 rounded-2xl p-4 gap-2 *:flex *:flex-col *:gap-2"
    >
      <!-- left col -->
      <div class="h-full lg:w-1/5">
        <!-- lieu -->
        <div class="goldCard">
          <h3 id="lieuTitle" class="goldTitle">
            Lieu - {biomeState.get().title}
          </h3>
          <p id="lieuDesc" class="text-white text-xs">
            {biomeState.get().desc}
          </p>
        </div>
        <!-- quête -->
        <div class="goldCard h-fit lg:max-h-100">
          <h3 class="goldTitle">Quêtes</h3>
          <div
            id="quest-list"
            class="h-full flex flex-col min-h-50 max-h-50 lg:max-h-100 gap-4 overflow-y-scroll hide-scrollbar"
          >
            <!-- {
              Array.isArray(quests)
                ? quests.map((quest) => (
                    <div class="flex w-full items-center">
                      <div class="flex flex-col w-full gap-1">
                        <p>{quest.name}</p>
                        <p class="text-xs text-white/75">{quest.desc}</p>
                      </div>
                      <div
                        class="size-4 rounded-md border border-Or-clair"
                        class:list={[quest.completed ? "bg-Or-clair" : ""]}
                      />
                    </div>
                  ))
                : "Vous n'avez pas de quêtes"
            } -->
          </div>
        </div>
        <!-- dice -->
        <div class="goldCard h-full">
          <h3 class="goldTitle">Jet de dé</h3>
          <div class="relative flex w-full h-full justify-center items-center">
            <Dice id="dice" />
            <p id="dice-result" class="absolute">{dice?.modifiedRoll || 20}</p>
          </div>
          <p id="dice-details" class="text-white self-center text-xs">
            {
              dice
                ? `${dice.roll} (D20) + ${dice.modifier} (modificateur) = ${dice.modifiedRoll}`
                : ""
            }
          </p>
        </div>
      </div>
      <!-- main col -->
      <div class="h-full lg:w-3/5 flex flex-col min-h-0">
        <!-- hp -->
        <div class="goldCard">
          <div class="flex w-full justify-between">
            <h3 class="goldTitle">Points de vie</h3>
            <p class="text-base sm:text-lg font-heading-3 font-bold">
              <span id="currentHP">{player.currentHP}</span> / <span id="maxHP"
                >{player.maxHP}</span
              >
            </p>
          </div>
        </div>
        <!-- chat -->
        <div class="goldCard flex flex-col h-full">
          <div
            id="messages-container-container"
            class="overflow-y-auto h-full flex flex-col gap-4 hide-scrollbar"
          >
            <div
              id="messages-container"
              class="flex flex-col gap-4 p-2 min-h-100 max-h-100 overflow-visible"
            >
              <!-- messages -->
            </div>
          </div>
          <!-- input -->
          <div class="flex w-full gap-2 p-2">
            <div class="w-full">
              <input
                id="input"
                class="w-full p-2 border border-Or-clair rounded-xl"
                type="text"
              />
            </div>
            <button id="button" class="goldCard hover:bg-Or-clair/50"
              >Envoyer</button
            >
          </div>
        </div>
      </div>
      <!-- right col -->
      <div class="h-full lg:w-1/5">
        <div class="goldCard">
          <h3 class="goldTitle">Statistiques</h3>
          <p class="self-center">{player.name} - {player.class}</p>
          <!-- tableau des stats -->
          <div
            class="grid grid-cols-4 self-center lg:grid-cols-2 lg:max-w-40 gap-2 p-4"
          >
            <div class="goldCell">
              <Epee />
            </div>
            <div class="goldCell">
              <p id="for">{player.for}</p>
            </div>
            <div class="goldCell">
              <Bouclier />
            </div>
            <div class="goldCell">
              <p id="def">{player.def}</p>
            </div>
            <div class="goldCell">
              <Magie />
            </div>
            <div class="goldCell">
              <p id="mag">{player.mag}</p>
            </div>
            <div class="goldCell">
              <Pied />
            </div>
            <div class="goldCell">
              <p id="agi">{player.agi}</p>
            </div>
          </div>
        </div>
        <!-- inventaire -->
        <div class="goldCard h-full max-h-50 lg:max-h-100">
          <h3 class="goldTitle">Inventaire</h3>
          <div
            id="inventory-list"
            class="h-full flex flex-col min-h-50 max-h-50 lg:max-h-100 gap-4 overflow-y-scroll hide-scrollbar"
          >
            <!-- {
              Array.isArray(inventory)
                ? inventory.map((item) => (
                    <div class="flex w-full items-center">
                      <div class="flex flex-col w-full gap-1">
                        <p>{item.name}</p>
                        <p class="text-xs text-white/75">{item.desc}</p>
                      </div>
                      <p class="text-xs text-white/75">x{item.amount}</p>
                    </div>
                  ))
                : "Votre inventaire est vide"
            } -->
          </div>
        </div>
      </div>
    </div>
  </div>

  <p id="hiddenId" class="hidden">{id}</p>

  <!-- biomeState management -->
  <script>
    import { biomeState } from "../stores/biome.js";

    const biomes = {
      elyndra: {
        title: "Ruines d'Élyndra",
        image: "/biomes/elyndra.webp",
        desc: "Une cité perdue avec des pierres runiques",
      },
      lunel: {
        title: "Forêt de Lunel",
        image: "/biomes/lunel.webp",
        desc: "Une jungle oppressante avec des cités perchées",
      },
      solarys: {
        title: "Dunes de Solarys",
        image: "/biomes/solarys.webp",
        desc: "Une immensité aride avec un oasis solitaire",
      },
      auralis: {
        title: "Vallée gelée d'Auralis",
        image: "/biomes/auralis.webp",
        desc: "Un refuge givré avec des vents mordants",
      },
    };

    biomeState.subscribe(() => {
      const state = biomeState.get();
      document.getElementById("bgImage").src = state.image;
      document.getElementById("title").textContent = state.title;
      document.getElementById("lieuTitle").textContent =
        "Lieu - " + state.title;
      document.getElementById("lieuDesc").textContent = state.desc;
    });

    function randomizeBiome() {
      const index =
        Object.keys(biomes)[(Math.random() * Object.keys(biomes).length) | 0];
      biomeState.set(biomes[index]);
    }

    // console.log("randomize");
    // randomizeBiome();
  </script>

  <!-- dice subscribtion -->
  <script>
    import PocketBase from "pocketbase";

    const pb = new PocketBase("http://elyndra.paolo-vincent.fr/");

    const id = document.getElementById("hiddenId")?.textContent;

    // ----------------------
    // DOM UPDATE
    // ----------------------
    function updateDice(dice) {
      const resultEl = document.getElementById("dice-result");
      const detailsEl = document.getElementById("dice-details");

      if (!resultEl || !detailsEl) return;

      const roll = dice?.roll ?? 0;
      const modifier = dice?.modifier ?? 0;
      const modified = dice?.modifiedRoll ?? roll + modifier;

      resultEl.textContent = modified;
      detailsEl.textContent = `${roll} (D20) + ${modifier} (modificateur) = ${modified}`;
    }

    // ----------------------
    // OPTIONAL: animation hook
    // ----------------------
    function animateDice() {
      const diceEl = document.getElementById("dice");
      if (!diceEl) return;

      diceEl.classList.add("animate-spin");

      setTimeout(() => {
        diceEl.classList.remove("animate-spin");
      }, 500);
    }

    // ----------------------
    // INIT
    // ----------------------
    async function init() {
      try {
        const collection = "Dice";

        let diceRecord = null;

        // 1. Try to fetch existing dice
        try {
          diceRecord = await pb
            .collection(collection)
            .getFirstListItem(`user="${id}"`);

          updateDice(diceRecord);
        } catch (err) {
          // No dice yet → that's fine
          console.log("No dice record yet");
        }

        // 2. Subscribe to ALL changes in collection
        pb.collection(collection).subscribe("*", (e) => {
          const record = e.record;

          // Only care about THIS user
          if (!record || record.user !== id) return;

          if (e.action === "create") {
            diceRecord = record;
            updateDice(record);
            animateDice();
          }

          if (e.action === "update") {
            diceRecord = record;
            updateDice(record);
            animateDice();
          }

          if (e.action === "delete") {
            diceRecord = null;
            updateDice(null);
          }
        });
      } catch (err) {
        console.error("Dice init error:", err);
      }
    }

    // ----------------------
    // START
    // ----------------------
    init();
  </script>

  <!-- side menu toggle -->
  <script>
    const menuToggle = document.getElementById("menu-toggle");
    const sideMenu = document.getElementById("side-menu");
    const menuOverlay = document.getElementById("menu-overlay");
    const closeMenuBtn = document.getElementById("close-menu");

    let menuOpen = false;

    function toggleMenu() {
      menuOpen = !menuOpen;

      if (menuOpen) {
        // Ouvrir le menu
        sideMenu.classList.remove("translate-x-full");
        menuOverlay.classList.remove("opacity-0", "pointer-events-none");

        // Cacher le bouton hamburger
        menuToggle.style.opacity = "0";
        menuToggle.style.pointerEvents = "none";
      } else {
        // Fermer le menu
        sideMenu.classList.add("translate-x-full");
        menuOverlay.classList.add("opacity-0", "pointer-events-none");

        // Réafficher le bouton hamburger
        menuToggle.style.opacity = "1";
        menuToggle.style.pointerEvents = "auto";
      }
    }

    menuToggle.addEventListener("click", toggleMenu);
    closeMenuBtn.addEventListener("click", toggleMenu);
    menuOverlay.addEventListener("click", toggleMenu);
  </script>

  <!-- verbomnes -->
  <script>
    const verbomnesButton = document.getElementById("verbomnes-button");
    const verbomnesModal = document.getElementById("verbomnes-modal");
    const closeVerbomnes = document.getElementById("close-verbomnes");

    function openVerbomnesModal() {
      verbomnesModal.classList.remove("opacity-0", "pointer-events-none");
      verbomnesModal.querySelector("div").classList.remove("scale-95");
      verbomnesModal.querySelector("div").classList.add("scale-100");
    }

    function closeVerbomnesModal() {
      verbomnesModal.classList.add("opacity-0", "pointer-events-none");
      verbomnesModal.querySelector("div").classList.remove("scale-100");
      verbomnesModal.querySelector("div").classList.add("scale-95");
    }

    verbomnesButton.addEventListener("click", openVerbomnesModal);
    closeVerbomnes.addEventListener("click", closeVerbomnesModal);

    // Fermer en cliquant sur l'overlay
    verbomnesModal.addEventListener("click", (e) => {
      if (e.target === verbomnesModal) {
        closeVerbomnesModal();
      }
    });
  </script>

  <!-- chat api endpoint -->
  <script>
    import { biomeState } from "../stores/biome.js";

    const biomes = {
      elyndra: {
        title: "Ruines d'Élyndra",
        image: "/biomes/elyndra.webp",
        desc: "Une cité perdue avec des pierres runiques",
      },
      lunel: {
        title: "Forêt de Lunel",
        image: "/biomes/lunel.webp",
        desc: "Une jungle oppressante avec des cités perchées",
      },
      solarys: {
        title: "Dunes de Solarys",
        image: "/biomes/solarys.webp",
        desc: "Une immensité aride avec un oasis solitaire",
      },
      auralis: {
        title: "Vallée gelée d'Auralis",
        image: "/biomes/auralis.webp",
        desc: "Un refuge givré avec des vents mordants",
      },
    };

    const button = document.getElementById("button") as HTMLButtonElement;
    const input = document.getElementById("input") as HTMLInputElement;
    const messagesContainer = document.getElementById(
      "messages-container",
    ) as HTMLDivElement;

    let messages: Array<{ role: string; content: string }> = [];

    if (button && input && messagesContainer) {
      button.addEventListener("click", async () => {
        const userMessage = input.value.trim();
        if (!userMessage) return;

        messages.push({ role: "user", content: userMessage });

        const userMessageDiv = document.createElement("div");
        userMessageDiv.classList.add("userMessage");
        userMessageDiv.textContent = userMessage;
        messagesContainer.appendChild(userMessageDiv);

        scrollToBottom();

        input.value = "";

        const res = await fetch("/apiEndpoint/chat.json", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify({
            messages: messages,
          }),
        });

        if (!res.ok) {
          const text = await res.text();
          messagesContainer.textContent = `Error ${res.status}: ${text}`;
          return;
        }

        const data = await res.json();

        messages.push({ role: "assistant", content: data.reply });

        const assistantMessageDiv = document.createElement("div");
        assistantMessageDiv.classList.add("assistantMessage");
        assistantMessageDiv.textContent = data.reply;
        messagesContainer.appendChild(assistantMessageDiv);

        scrollToBottom();
      });

      input.addEventListener("keypress", (e) => {
        if (e.key === "Enter") {
          button.click();
        }
      });

      const state = biomeState.get();

      messages.push({
        role: "user",
        content: `
Ceci est un message interne non visible par le joueur.

========================
OBJECTIF
========================
Initialiser complètement l’aventure du joueur :
- contexte narratif
- état du personnage
- inventaire de départ
- premières quêtes
- éléments persistants du gamestate

Tu dois produire une introduction immersive ET initialiser l’état du jeu via les tools.

========================
PROTOCOLE OBLIGATOIRE
========================

Tu dois suivre STRICTEMENT cette séquence :

1. Récupérer les informations du joueur via les tools
2. Récupérer le lore via getLoreRAG
3. Construire mentalement :
   - identité du joueur
   - situation initiale
   - éléments de départ

4. INITIALISER l’état du jeu via les tools :
   - vérifier l'état du jeu en listant séparément inventaire et quêtes (listInventory) (listQuest)
   - créer l’inventaire de départ (createItem)
   - créer les premières quêtes (createQuest)
   - enregistrer les éléments importants (addGamestate)
   - mettre à jour le personnage si nécessaire (updatePlayer)

5. Générer ensuite UNIQUEMENT la narration immersive d’introduction

========================
RÈGLES IMPORTANTES
========================
- Toute donnée persistante (inventaire, quête, état) DOIT être créée via tools
- Ne jamais seulement décrire un élément sans le créer
- Ne jamais inventer d’ID → utiliser uniquement ceux retournés par les tools
- Ne pas attendre la fin pour gérer l’état : les tools doivent être appelés pendant la phase d’initialisation
- Chaque élément important introduit dans la narration doit exister dans le gamestate

========================
CONTENU DE L’INTRODUCTION
========================
Tu dois introduire :

- La région : ${state.title}, ${state.description}
- L’environnement immédiat
- L’ambiance
- La situation de départ

Progressivement :
- L’identité du joueur
- Ses origines (déduites ou issues des données)
- Son inventaire initial (cohérent avec l’univers)
- Ses premières motivations implicites

Tu dois également :
- Introduire au moins une ou plusieurs quêtes initiales (tutoriel ou objectif simple)
- Donner des points d’ancrage narratifs pour guider le joueur

========================
CONTRAINTES NARRATIVES
========================
- Style immersif, sensoriel, fluide
- Réponse courte (1 à 3 paragraphes)
- Pas de listes visibles
- Pas d’explications hors narration
- Toujours terminer par une ouverture ou une question

========================
TON
========================
- Accrocheur
- Immersif
- Progressif
- Clair sans être explicatif

========================
IMPORTANT
========================
Tu dois :
- appeler les tools nécessaires AVANT de produire la narration
- synchroniser l’état du jeu dès l’initialisation
- ne commencer la narration qu’après avoir créé l’état initial complet
`,
      });

      const res = await fetch("/apiEndpoint/chat.json", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          messages: messages,
        }),
      });

      if (!res.ok) {
        const text = await res.text();
        messagesContainer.textContent = `Error ${res.status}: ${text}`;
      }

      const data = await res.json();

      messages.push({ role: "assistant", content: data.reply });

      const assistantMessageDiv = document.createElement("div");
      assistantMessageDiv.classList.add("assistantMessage");
      assistantMessageDiv.textContent = data.reply;
      messagesContainer.appendChild(assistantMessageDiv);

      scrollToBottom();
    }

    function scrollToBottom() {
      const container = document.getElementById("messages-container-container");
      container.scrollTop = container.scrollHeight;
    }

    scrollToBottom();
  </script>

  <!-- inventory subscribtion -->
  <script>
    import PocketBase from "pocketbase";

    const pb = new PocketBase("http://elyndra.paolo-vincent.fr/");

    const id = document.getElementById("hiddenId")?.textContent;

    // ----------------------
    // STATE
    // ----------------------
    let inventory = [];

    // ----------------------
    // DOM RENDER
    // ----------------------
    function renderInventory() {
      const container = document.getElementById("inventory-list");

      if (!container) return;

      if (!inventory.length) {
        container.innerHTML = "Votre inventaire est vide";
        return;
      }

      container.innerHTML = inventory
        .map(
          (item) => `
    <div class="flex w-full items-center" data-id="${item.id}">
      <div class="flex flex-col w-full gap-1">
        <p>${escapeHtml(item.name)}</p>
        <p class="text-xs text-white/75">${escapeHtml(item.desc)}</p>
      </div>
      <p class="text-xs text-white/75">x${item.amount}</p>
    </div>
  `,
        )
        .join("");
    }

    // ----------------------
    // HELPERS (avoid XSS)
    // ----------------------
    function escapeHtml(str = "") {
      return str
        .replaceAll("&", "&amp;")
        .replaceAll("<", "&lt;")
        .replaceAll(">", "&gt;")
        .replaceAll('"', "&quot;")
        .replaceAll("'", "&#039;");
    }

    // ----------------------
    // STATE MUTATIONS
    // ----------------------
    function addItem(item) {
      if (inventory.find((i) => i.id === item.id)) return; // avoid duplicates
      inventory.push(item);
      renderInventory();
    }

    function updateItem(item) {
      const i = inventory.findIndex((i) => i.id === item.id);
      if (i !== -1) {
        inventory[i] = item;
        renderInventory();
      }
    }

    function removeItem(id) {
      inventory = inventory.filter((i) => i.id !== id);
      renderInventory();
    }

    // ----------------------
    // INIT
    // ----------------------
    async function init() {
      try {
        // Initial load (filter by user if needed)
        inventory = await pb.collection("Inventory_" + id).getFullList();

        renderInventory();

        // Subscribe to live updates
        pb.collection("Inventory_" + id).subscribe("*", (e) => {
          const item = e.record;

          if (e.action === "create") addItem(item);
          if (e.action === "update") updateItem(item);
          if (e.action === "delete") removeItem(item.id);
        });
      } catch (err) {
        console.error("Inventory init error:", err);
      }
    }

    // ----------------------
    // START
    // ----------------------
    init();
  </script>

