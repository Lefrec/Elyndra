  <!-- player subscription -->
  <script>
    import PocketBase from "pocketbase";

    const pb = new PocketBase("http://elyndra.paolo-vincent.fr/");

    const id = document.getElementById("hiddenId")?.textContent;

    // ----------------------
    // DOM UPDATE
    // ----------------------
    function updateStats(player) {
      setText("for", player.for);
      setText("def", player.def);
      setText("mag", player.mag);
      setText("agi", player.agi);
      setText("currentHP", player.currentHP);
      setText("maxHP", player.maxHP);
    }

    // ----------------------
    // SMALL HELPER
    // ----------------------
    function setText(id, value) {
      const el = document.getElementById(id);
      if (el) el.textContent = value ?? 0;
    }

    // ----------------------
    // OPTIONAL: visual feedback
    // ----------------------
    function flash(el) {
      if (!el) return;

      el.classList.add("bg-Or-clair/30");
      setTimeout(() => {
        el.classList.remove("bg-Or-clair/30");
      }, 300);
    }

    function updateStatWithEffect(id, newValue) {
      const el = document.getElementById(id);
      if (!el) return;

      if (el.textContent != newValue) {
        el.textContent = newValue;
        flash(el);
      }
    }

    // ----------------------
    // INIT
    // ----------------------
    async function init() {
      try {
        // Get current player
        const players = await pb
          .collection("Player_" + id)
          .getFullList({ filter: `isCurrent = true` });
        const player = players[0];

        // Initial render
        updateStats(player);

        // Subscribe to THIS player only
        pb.collection("Player_" + id).subscribe(player.id, (e) => {
          const updated = e.record;

          if (e.action === "update") {
            updateStatWithEffect("for", updated.for);
            updateStatWithEffect("def", updated.def);
            updateStatWithEffect("mag", updated.mag);
            updateStatWithEffect("agi", updated.agi);
            updateStatWithEffect("currentHP", updated.currentHP);
            updateStatWithEffect("maxHP", updated.maxHP);
          }
        });
      } catch (err) {
        console.error("Stats init error:", err);
      }
    }

    // ----------------------
    // START
    // ----------------------
    init();
  </script>
</Layout>
