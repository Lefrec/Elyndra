---
const { text } = Astro.props;
---

<div class="flex items-center gap-2">
  <div class="h-px w-5 bg-Or-clair/40"></div>
  <span
    class="text-[0.6rem] md:text-[0.65rem] uppercase tracking-[0.2em] text-Or-clair/55 font-body"
    >{text}</span
  >
  <div class="h-px w-5 bg-Or-clair/40"></div>
</div>
