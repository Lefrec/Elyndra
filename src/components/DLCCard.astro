---
const { dlc } = Astro.props;
---

<div 
  class="bg-gradient-to-b from-[#0E0E0E] to-[#090D13] border border-[#353120] rounded-2xl overflow-hidden shadow-2xl flex flex-col h-full w-full transition-colors duration-200 hover:border-[#FFE9B5]"
>
  <!-- Image + Badges -->
  <div class="relative h-64 overflow-hidden">
    <img src={dlc.image} alt={dlc.title} class="w-full h-full object-cover" loading="lazy" />
    <div class="absolute inset-0 bg-gradient-to-t from-[#090D13]/90 via-transparent to-transparent" />
    
    <!-- Badges -->
    <div class="absolute top-4 left-4 flex gap-2 z-10">
      {dlc.isNew && (
        <div class="px-3 py-1.5 rounded-md font-bold text-sm shadow-lg" style={{ backgroundColor: '#16446B', color: '#E8E5D8' }}>
          NOUVEAU
        </div>
      )}
      {dlc.featured && (
        <div class="px-3 py-1.5 rounded-md font-bold text-sm shadow-lg" style={{ backgroundColor: '#FFE9B5', color: '#00234B' }}>
          ⭐ RECOMMANDÉ
        </div>
      )}
    </div>
  </div>

  <!-- Contenu -->
  <div class="p-6 flex-1 flex flex-col">
    <h3 class="text-xl font-black mb-3" style={{ color: '#E8E5D8' }}>{dlc.title}</h3>
    <p class="text-sm mb-6 leading-relaxed flex-1" style={{ color: '#9C9C9C' }}>{dlc.description}</p>

    <!-- Prix -->
    <div class="mb-6 pb-6" style={{ borderBottom: '1px solid #353120' }}>
      <div class="flex items-center justify-between mb-3">
        <span class="text-2xl font-bold" style={{ color: '#E8E5D8' }}>{dlc.price.toFixed(2)}€</span>
        <div class="flex items-center gap-2 font-semibold" style={{ color: '#FFE9B5' }}>
          <div class="w-4 h-4 bg-yellow-400 rounded-full"></div>
          <span>{dlc.credits} crédits</span>
        </div>
      </div>
    </div>

    <!-- Bouton -->
    <button data-dlc-id={dlc.id} class="add-to-cart-btn w-full bg-[#FFE9B5] text-[#090D13] font-bold py-3 px-4 rounded-lg uppercase text-sm hover:bg-yellow-400 transition-colors mt-auto shadow-lg">
      Ajouter au panier
    </button>

    <!-- Features -->
    <div class="mt-4 space-y-2 text-xs" style={{ color: '#9C9C9C' }}>
      <div class="flex items-center gap-2">
        <div class="w-1.5 h-1.5 bg-[#FFE9B5] rounded-full"></div>
        <span>Contenu narratif</span>
      </div>
      <div class="flex items-center gap-2">
        <div class="w-1.5 h-1.5 bg-[#FFE9B5] rounded-full"></div>
        <span>Nouveaux personnages</span>
      </div>
      <div class="flex items-center gap-2">
        <div class="w-1.5 h-1.5 bg-[#FFE9B5] rounded-full"></div>
        <span>Contenu permanent</span>
      </div>
    </div>
  </div>
</div>
