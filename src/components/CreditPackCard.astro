---
const { 
  name, 
  credits, 
  price, 
  image, 
  isPopular = false 
} = Astro.props;
---

<div class={`credit-card bg-[#0E0E0E] border-2 border-[#353120] rounded-xl p-6 text-center relative shadow-lg flex flex-col h-full ${isPopular ? 'ring-2 ring-[#FFE9B5]/30 -mt-2 z-10' : ''}`}>
  
  <!-- SVG 30x30px - MÊME LOGIQUE POUR TOUS -->
  <div class="w-[38px] h-[38px] mx-auto mb-3 bg-[#FFE9B5] rounded-lg flex items-center justify-center p-2 shadow-md">
    <!-- SVG avec <img> (fonctionne parfaitement) -->
    <img src={image} alt={`${name}`} class="w-[30px] h-[30px] object-contain" loading="lazy" />
  </div>
  
  <h3 class="text-xl font-bold text-[#FFE9B5] mb-3 flex-grow">{name}</h3>
  <div class="text-4xl font-black text-[#E8E5D8] mb-1">{credits}</div>
  <div class="text-xs text-[#9C9C9C] uppercase tracking-wider mb-4">crédits</div>
  <div class="text-2xl font-bold text-[#FFE9B5] mb-6">{price}</div>
  <button class="w-full bg-[#FFE9B5] text-[#090D13] font-bold py-3 px-4 rounded-lg uppercase text-sm hover:bg-yellow-400 transition-colors mt-auto">
    Ajouter au panier
  </button>
</div>
