---
import Decorations from "./CardsBiomeDecorations.astro";
const {image, title, description} = Astro.props;
---

<button
  class="group w-full relative overflow-hidden rounded-xl md:rounded-2xl border-2 border-transparent cursor-pointer text-left transition-all duration-300 bg-transparent"
>
  <div class="relative h-56 sm:h-72 md:h-80 lg:h-96 overflow-hidden">
    <img
      src={image}
      alt={title}
      class="biome-img absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
    />
    <div
      class="absolute inset-0 bg-gradient-to-t from-Background-dark-blue/95 via-Background-dark-blue/50 to-transparent"
    >
    </div>
  </div>

  <div class="absolute inset-0 flex flex-col justify-end p-3 md:p-6">
    <div
      class="border border-Or-clair/40 rounded-lg md:rounded-xl p-3 md:p-6 backdrop-blur-sm bg-Background-dark-blue/30 transition-all duration-300 group-hover:border-Or-clair/70 group-hover:bg-Background-dark-blue/50"
    >
      <Decorations/>
      <h3
        class="text-sm md:text-xl font-semibold text-center mb-2 md:mb-4 text-Or-clair tracking-wide"
      >
        {title}
      </h3>
      <Decorations/>
      <p class="text-xs md:text-sm text-center text-white/75 leading-relaxed">
        {description}
      </p>
    </div>
  </div>
</button>
