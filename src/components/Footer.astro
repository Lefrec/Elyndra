                    <a href="#" class="w-11 h-11 bg-amber-200 rounded hover:bg-amber-300 transition-colors" aria-label="Instagram">
                    </a>
                    <a href="#" class="w-11 h-11 bg-amber-200 rounded hover:bg-amber-300 transition-colors" aria-label="Discord">
                    </a>
                </div>
            </div>
        </div>

        <!-- Copyright -->
        <div class="border-t border-slate-700 pt-8">
