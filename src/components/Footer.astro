<footer class="bg-black text-white">
    <div class="max-w-7xl mx-auto px-8 py-12">
        <!-- Contenu principal du footer -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-8">
            <!-- Logo -->
            <div>
                <h2 class="text-3xl font-bold text-elyndra-gradient font-heading">
                    ELYNDRA
                </h2>
            </div>

            <!-- Liens légaux -->
            <nav>
                <ul class="flex flex-col gap-6">
                    <li>
                        <a href="#" class="text-lg font-bold font-heading hover:text-amber-100 transition-colors">
                            Contact
                        </a>
                    </li>
                    <li>
                        <a href="#" class="text-lg font-bold font-heading hover:text-amber-100 transition-colors">
                            Politique de confidentialité
                        </a>
                    </li>
                    <li>
                        <a href="#" class="text-lg font-bold font-heading hover:text-amber-100 transition-colors">
                            Mentions légales
