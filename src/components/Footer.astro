---
import discordImg from '../assets/footer/discord.webp';
import instaImg from '../assets/footer/insta.webp';
import linkedinImg from '../assets/footer/linkedin.webp';
import twitterImg from '../assets/footer/twitter.webp';
---

<footer class="bg-black text-white">
    <div class="max-w-7xl mx-auto px-4 md:px-6 py-8">

        <!-- Contenu principal -->
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-8 mb-6">

            <!-- Logo -->
            <div class="text-center sm:text-left">
                <h2 class="text-2xl font-bold text-elyndra-gradient font-heading">
                    ELYNDRA
                </h2>
            </div>

            <!-- Liens légaux -->
            <nav class="text-center sm:text-left">
                <ul class="flex flex-col gap-3">
                    <li>
                        <a href="#" class="text-sm font-bold font-heading hover:text-amber-100 transition-colors">
                            Contact
                        </a>
                    </li>
                    <li>
                        <a href="/politique_confidentialite" class="text-sm font-bold font-heading hover:text-amber-100 transition-colors">
                            Politique de confidentialité
                        </a>
                    </li>
                    <li>
                        <a href="/mentions_legales" class="text-sm font-bold font-heading hover:text-amber-100 transition-colors">
                            Mentions légales
                        </a>
                    </li>
                    <li>
                        <a href="/cgu" class="text-sm font-bold font-heading hover:text-amber-100 transition-colors">
                            CGU
                        </a>
                    </li>
                </ul>
            </nav>

            <!-- Réseaux sociaux -->
            <div class="text-center sm:text-left sm:col-span-2 md:col-span-1">
                <h3 class="text-sm font-bold font-heading mb-3">
                    Rejoignez notre univers
                </h3>
                <div class="flex gap-3 justify-center sm:justify-start">
                    <a href="#" class="w-9 h-9 flex items-center justify-center p-1.5" aria-label="LinkedIn">
                        <img src={linkedinImg.src} alt="LinkedIn" class="w-full h-full object-contain" />
                    </a>
                    <a href="#" class="w-9 h-9 flex items-center justify-center p-1.5" aria-label="Twitter">
                        <img src={twitterImg.src} alt="Twitter" class="w-full h-full object-contain" />
                    </a>
                    <a href="#" class="w-9 h-9 flex items-center justify-center p-1.5" aria-label="Instagram">
                        <img src={instaImg.src} alt="Instagram" class="w-full h-full object-contain" />
                    </a>
                    <a href="#" class="w-9 h-9 flex items-center justify-center p-1.5" aria-label="Discord">
                        <img src={discordImg.src} alt="Discord" class="w-full h-full object-contain" />
                    </a>
                </div>
            </div>

        </div>

        <!-- Copyright -->
        <div class="border-t border-slate-700 pt-6">
            <p class="text-center text-xs text-gray-400 font-heading">
                Tous contenus sont réservés de droit
            </p>
        </div>

    </div>
</footer>
